(module thecount.engine-test)
(import "coil.slice" :as slice)
(import "coil.alloc" :as alloc)
(import "coil.io" :use [write])
(import "coil.os" :as os)
(import "thecount.engine" :use [rb-new read-fd-into! ReadBuf])
(import "thecount.walk" :use [resolved-dirent-type DT-UNKNOWN DT-DIR DT-REG])

;;; A pipe reliably returns fewer bytes than the reusable file buffer holds.
;;; A short positive read must not discard the remaining bytes.
(deftest short-read-continues-until-eof
         (let [(mut fds) (zeroed (array i32 2))
               a (alloc/malloc-allocator)]
           (assert-eq (os/pipe (cast (ptr i32) (mut fds))) 0)
           (assert-eq (alloc/write (load (index (mut fds) 1))
                                   (cast (ptr i8) (slice/slice-data "abc"))
                                   3)
                      3)
           (assert-eq (alloc/write (load (index (mut fds) 1))
                                   (cast (ptr i8) (slice/slice-data "def"))
                                   3)
                      3)
           (os/close (load (index (mut fds) 1)))
           (let [rb (rb-new a)
                 size (read-fd-into! a rb (load (index (mut fds) 0)))]
             (assert-eq size 6)
             (assert (= (slice/slice-new (load (field rb p)) size) "abcdef")))))

(deftest unknown-dirent-type-resolved
         (let [dfd (os/open c"." 0)]
           (assert (>= dfd 0))
           (assert-eq (resolved-dirent-type dfd c"src" DT-UNKNOWN) DT-DIR)
           (assert-eq (resolved-dirent-type dfd c"src/main.coil" DT-UNKNOWN)
                      DT-REG)
           (assert-eq (resolved-dirent-type dfd c"src" DT-DIR) DT-DIR)
           (os/close dfd)))
