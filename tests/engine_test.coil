(module thecount.engine-test)
(import "coil.alloc" :as alloc)
(import "coil.io" :use [write])
(import "coil.os" :as os)
(import "coil.fs" :as fs)
(import "coil.str" :as str)
(import "coil.hashmap" :as hashmap)
(import "coil.arraylist" :as arraylist)
(import "thecount.engine"
        :use
        [rb-new read-fd-into! read-into! read-into-at! ReadBuf BINARY-SNIFF
         READ-BINARY Agg new-agg agg-file! agg-merge! walk-roots-of])
(import "thecount.registry" :as registry)
(import "thecount.counter" :as counter)
(import "thecount.output" :use [Row])
(import "coil.mem" :use [fill])
(import "thecount.util" :use [must-alloc])
(import "thecount.walk"
        :use
        [resolved-dirent-type resolved-directory-entry-type DT-UNKNOWN DT-DIR
         DT-REG])

;;; A pipe reliably returns fewer bytes than the reusable file buffer holds.
;;; A short positive read must not discard the remaining bytes.
(deftest short-read-continues-until-eof
  (let [(mut fds) (zeroed (array i32 2))
        a (alloc/malloc-allocator)]
    (assert-eq (os/pipe (cast (ptr i32) (mut fds))) 0)
    (assert-eq (alloc/write (load (index (mut fds) 1))
                            (cast (ptr i8) (data "abc"))
                            3)
               3)
    (assert-eq (alloc/write (load (index (mut fds) 1))
                            (cast (ptr i8) (data "def"))
                            3)
               3)
    (os/close (load (index (mut fds) 1)))
    (let [rb (rb-new a)
          size (read-fd-into! a rb (load (index (mut fds) 0)))]
      (assert-eq size 6)
      (assert (= (slice::new (load (field rb p)) size) "abcdef")))))

(deftest unknown-dirent-type-resolved
  (let [dfd (os/open c"." 0)]
    (assert (>= dfd 0))
    (assert-eq (resolved-dirent-type dfd c"src" DT-UNKNOWN) DT-DIR)
    (assert-eq (resolved-dirent-type dfd c"src/main.coil" DT-UNKNOWN)
               DT-REG)
    (assert-eq (resolved-dirent-type dfd c"src" DT-DIR) DT-DIR)
    (os/close dfd)))

;;; Opening a basename through the capability must match reading its full path.
(deftest directory-relative-read
  (let [a (alloc/malloc-allocator)
        direct (rb-new a)
        relative (rb-new a)
        size (read-into! a direct c"src/main.coil")]
    (assert (> size 0))
    (try (let [(mut directory)
                 (try-or! (fs/Directory::open a "src") (assert false))]
           (assert-eq (read-into-at! a
                                     relative
                                     (mut directory)
                                     c"main.coil")
                      size)
           (assert (= (slice::new (.p direct) size)
                      (slice::new (.p relative) size)))
           (assert-eq (read-into-at! a
                                     relative
                                     (mut directory)
                                     c"thecount-no-such-file")
                      -1)
           (match (close! (mut directory))
             (Ok [_] (assert true))
             (Err [_] (assert false)))))))

;;; Write `n` copies of `fill-byte` to fd, with `nul-at` (if >= 0) replaced by
;;; a NUL byte, then close it.
(defn write-pattern! [(fd i32) (n i64) (fill-byte u8) (nul-at i64)] (-> i64)
  (let [a (alloc/malloc-allocator)
        p (must-alloc [u8] a n)]
    (fill p fill-byte n)
    (when (>= nul-at 0)
      (set! (index p nul-at) (: 0 u8))
      0)
    (assert-eq (alloc/write fd (cast (ptr i8) p) n) n)
    (os/close fd)
    0))

(defn read-pattern [(n i64) (nul-at i64)] (-> i64)
  (let [(mut fds) (zeroed (array i32 2))
        a (alloc/malloc-allocator)]
    (assert-eq (os/pipe (cast (ptr i32) (mut fds))) 0)
    (write-pattern! (load (index (mut fds) 1)) n (: 97 u8) nul-at)
    (read-fd-into! a (rb-new a) (load (index (mut fds) 0)))))

(deftest nul-in-sniff-window-reads-as-binary
  (assert-eq (read-pattern 5 2) READ-BINARY)
  (assert-eq (read-pattern (+ BINARY-SNIFF 4000) 0) READ-BINARY)
  (assert-eq (read-pattern (+ BINARY-SNIFF 4000) (- BINARY-SNIFF 1))
             READ-BINARY))

(deftest nul-past-sniff-window-is-text
  (assert-eq (read-pattern (+ BINARY-SNIFF 4000) BINARY-SNIFF)
             (+ BINARY-SNIFF 4000))
  (assert-eq (read-pattern 100 -1) 100))

(defn unknown-agg [(a (dyn alloc/Allocator)) (r (ptr registry/Registry))]
  (-> (ptr Agg))
  (let [roots
          (alloc/box! a
                      (arraylist/ArrayList (slice u8))
                      (arraylist/ArrayList::new [(slice u8)] a))]
    (push! roots ".")
    (new-agg a
             (alloc/box! a hashmap/KeyOps (load (str/keyops)))
             (registry/reg-count r)
             true
             true
             1
             (walk-roots-of a roots)
             true)))

(defn find-row [(rows (ptr (arraylist/ArrayList Row)))
                (label (slice u8))
                (sub (slice u8))] (-> (ptr Row))
  (let [(mut hit) (cast (ptr Row) 0)]
    (for [i 0 (len (load rows))]
      (let [rp (index (data (slice (load rows))) i)]
        (when (and (= (.label rp) label) (= (.sub rp) sub))
          (set! (mut hit) rp)
          0)))
    (when (= hit (cast (ptr Row) 0))
      (panic "no row {s} / {s}" label sub))
    hit))

;; --unknown: every view labels a file by its extension, and the per-extension
;; totals survive merging worker aggregates.
(deftest unknown-breakdown-labels-every-view-by-extension
  (let [a (alloc/malloc-allocator)
        r (registry/reg-new a)]
    (registry/add-builtins! r)
    (registry/reg-only-unknown! r)
    (let [unk (registry/reg-classify-path r "x.lock")
          one
            (counter/Counts
              :lines 1
              :blank 0
              :comments 0
              :code 1)
          x (unknown-agg a r)
          y (unknown-agg a r)]
      (agg-file! a r x unk "c" "Cargo.LOCK" one)
      (agg-file! a r x unk "" "LICENSE" one)
      (agg-file! a r y unk "c" "yarn.lock" one)
      (agg-file! a r y unk "a/b" "notes.weird" one)
      (agg-merge! a x y)
      (assert-eq (len (load (.ext-rows x))) 3)
      (assert-eq (.files (find-row (.ext-rows x) ".lock" "")) 2)
      (assert-eq (.code (.c (find-row (.ext-rows x) ".lock" ""))) 2)
      (assert-eq (.files (find-row (.ext-rows x) "(none)" "")) 1)
      (assert-eq (.files (find-row (.ext-rows x) ".weird" "")) 1)
      (assert-eq (.files (find-row (.dir-rows x) "c" ".lock")) 2)
      (assert-eq (.files (find-row (.dir-rows x) "a" ".weird")) 1)
      (assert-eq (.files (find-row (.dir-rows x) "." "(none)")) 1)
      (assert-eq (len (load (.file-rows x))) 4)
      (assert-eq (.files (find-row (.file-rows x) "c/Cargo.LOCK" ".lock")) 1)
      (assert-eq (load (index (data (.files-per x)) unk)) 4))))
