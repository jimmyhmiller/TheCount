(module thecount.registry-test)
(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.str" :use *)
(import "thecount.lang" :use *)
(import "thecount.registry" :use *)
(import "thecount.counter" :use *)
(import "coil.arraylist" :use *)
(import "thecount.engine"
        :use
        [dir-lang-key dir-rollup-key dir-row-key dir-base-len walk-roots-of])

(defn fresh [] (-> (ptr Registry))
  (let [r (reg-new (malloc-allocator))]
    (add-builtins! r)
    r))

(deftest ext-lookup
         (let [r (fresh)]
           (assert (>= (reg-lookup-path r "src/main.rs") 0))
           (assert (>= (reg-lookup-path r "a/b/c.tar.py") 0))
           (assert-eq (reg-lookup-path r "noextension") -1)
           (assert-eq (reg-lookup-path r "photo.jpg") -1)))

(deftest ext-lookup-names
         (let [r (fresh)]
           (let [rs (reg-lookup-path r "main.rs")]
             (assert (= (load (field (reg-spec r rs) name)) "Rust")))
           (let [up (reg-lookup-path r "MAIN.RS")]
             (assert (= (load (field (reg-spec r up) name)) "Rust")))))

(deftest filename-lookup
         (let [r (fresh)]
           (let [mk (reg-lookup-path r "some/dir/Makefile")]
             (assert (= (load (field (reg-spec r mk) name)) "Makefile")))
           (let [dk (reg-lookup-path r "Dockerfile")]
             (assert (= (load (field (reg-spec r dk) name)) "Dockerfile")))
           (let [rk (reg-lookup-path r "proj/Rakefile")]
             (assert (= (load (field (reg-spec r rk) name)) "Ruby")))))

(deftest name-lookup-case-insensitive
         (let [r (fresh)]
           (assert (>= (reg-lookup-name r "rust") 0))
           (assert (>= (reg-lookup-name r "RUST") 0))
           (assert (>= (reg-lookup-name r "c++ header") 0))
           (assert-eq (reg-lookup-name r "nope-lang") -1)))

(deftest override-shadows-builtin
         (let [r (fresh)
               a (malloc-allocator)
               custom (lang-from-strings a "MyPython" "#" "" false "\"'" "")]
           (reg-add! r custom "py")
           (let [idx (reg-lookup-path r "x.py")]
             (assert (= (load (field (reg-spec r idx) name)) "MyPython")))))

(deftest dotfile-is-not-extension
         (let [r (fresh)]
           ;; .gitignore should not match a "gitignore" extension nor crash
           (assert-eq (reg-lookup-path r ".gitignore") -1)))

(deftest nim-nested-block-vs-line
         ;; #[ must win over # so nested block comments count as comments
         (let [r (fresh)
               idx (reg-lookup-name r "nim")
               src "#[ outer\n#[ inner ]#\nstill comment ]#\nx = 1\n"
               c (count-bytes (reg-spec r idx) src)]
           (assert-eq (load (field c comments)) 3)
           (assert-eq (load (field c code)) 1)))

(deftest lua-block-vs-line
         (let [r (fresh)
               idx (reg-lookup-name r "lua")
               src "--[[ block\nstill ]]\nx = 1 -- line\n-- whole line\n"
               c (count-bytes (reg-spec r idx) src)]
           (assert-eq (load (field c comments)) 3)
           (assert-eq (load (field c code)) 1)))

;; --- --dirs rollup keys -----------------------------------------------------
;; --dirs keeps one row per (directory, language), so the rollup key has to
;; separate the two halves unambiguously — otherwise a directory whose name
;; ends where a language name begins would merge two different rows.
(deftest dir-lang-key-separates-halves
         (let [a (malloc-allocator)]
           (assert (= (dir-lang-key a "src" "C") (dir-lang-key a "src" "C")))
           (assert (= (= (dir-lang-key a "src" "C")
                         (dir-lang-key a "src" "C++"))
                      false))
           (assert (= (= (dir-lang-key a "src" "C") (dir-lang-key a "srcC" ""))
                      false))
           (assert (= (= (dir-lang-key a "a/b" "Go")
                         (dir-lang-key a "a" "b/Go"))
                      false))))

(deftest dir-lang-key-handles-root-and-empty
         (let [a (malloc-allocator)]
           (assert (= (slice-len (dir-lang-key a "." "Markdown")) 10))
           (assert (= (= (dir-lang-key a "." "C") (dir-lang-key a "." "D"))
                      false))))

(deftest dir-rollup-key-depth
         (assert (= (dir-rollup-key "a/b/c" 0 1) "a"))
         (assert (= (dir-rollup-key "a/b/c" 0 2) "a/b"))
         (assert (= (dir-rollup-key "a/b/c" 0 9) "a/b/c"))
         (assert (= (dir-rollup-key "" 0 1) ".")))

;; depth is counted from the walk root, so `thecount src` groups by src's own
;; subdirectories rather than putting everything in one "src" row
(deftest dir-rollup-key-root-relative
         (assert (= (dir-rollup-key "src" 3 1) "src"))
         (assert (= (dir-rollup-key "src/bus" 3 1) "src/bus"))
         (assert (= (dir-rollup-key "src/bus/cc" 3 1) "src/bus"))
         (assert (= (dir-rollup-key "src/bus/cc" 3 2) "src/bus/cc"))
         (assert (= (dir-rollup-key "a/b/c" 3 1) "a/b/c")))

(deftest dir-row-key-makes-named-root-explicit
         (let [a (malloc-allocator)]
           (assert (= (dir-row-key a "src" 3 1) "src/."))
           (assert (= (dir-row-key a "src/bus" 3 1) "src/bus"))
           (assert (= (dir-row-key a "" 0 1) "."))))

(defn roots3 [(a (dyn Allocator))
              (x (slice u8))
              (y (slice u8))
              (z (slice u8))] (-> (ptr (ArrayList (slice u8))))
  (let [l (box! a (ArrayList (slice u8)) (al-new [(slice u8)] a))]
    (al-push! l x)
    (al-push! l y)
    (al-push! l z)
    l))

(deftest dir-base-len-longest-component-match
         (let [a (malloc-allocator)
               rs (roots3 a "src" "src/bus" "vendor")]
           (assert-eq (dir-base-len rs "src") 3)
           (assert-eq (dir-base-len rs "src/tui") 3)
           (assert-eq (dir-base-len rs "src/bus/cc") 7)
           (assert-eq (dir-base-len rs "srcX/y") 0)
           (assert-eq (dir-base-len rs "other") 0)))

(deftest walk-roots-dot-becomes-empty
         (let [a (malloc-allocator)
               w (walk-roots-of a (roots3 a "." "src" "vendor"))]
           (assert-eq (slice-len (al-get (load w) 0)) 0)
           (assert (= (al-get (load w) 1) "src"))
           (assert-eq (dir-base-len w "anything/here") 0)))
