(module thecount.registry-test)
(import "coil.slice" :as slice)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "thecount.lang" :as lang)
(import "thecount.registry" :as registry)
(import "thecount.counter" :as counter)
(import "coil.arraylist" :as arraylist)
(import "thecount.engine"
        :use
        [dir-lang-key dir-rollup-key dir-row-key dir-base-len walk-roots-of])

(defn fresh [] (-> (ptr registry/Registry))
  (let [r (registry/reg-new (alloc/malloc-allocator))]
    (registry/add-builtins! r)
    r))

(deftest ext-lookup
         (let [r (fresh)]
           (assert (>= (registry/reg-lookup-path r "src/main.rs") 0))
           (assert (>= (registry/reg-lookup-path r "a/b/c.tar.py") 0))
           (assert-eq (registry/reg-lookup-path r "noextension") -1)
           (assert-eq (registry/reg-lookup-path r "photo.jpg") -1)))

(deftest ext-lookup-names
         (let [r (fresh)]
           (let [rs (registry/reg-lookup-path r "main.rs")]
             (assert (= (.name (registry/reg-spec r rs)) "Rust")))
           (let [up (registry/reg-lookup-path r "MAIN.RS")]
             (assert (= (.name (registry/reg-spec r up)) "Rust")))))

(deftest filename-lookup
         (let [r (fresh)]
           (let [mk (registry/reg-lookup-path r "some/dir/Makefile")]
             (assert (= (.name (registry/reg-spec r mk)) "Makefile")))
           (let [dk (registry/reg-lookup-path r "Dockerfile")]
             (assert (= (.name (registry/reg-spec r dk)) "Dockerfile")))
           (let [rk (registry/reg-lookup-path r "proj/Rakefile")]
             (assert (= (.name (registry/reg-spec r rk)) "Ruby")))))

(deftest name-lookup-case-insensitive
         (let [r (fresh)]
           (assert (>= (registry/reg-lookup-name r "rust") 0))
           (assert (>= (registry/reg-lookup-name r "RUST") 0))
           (assert (>= (registry/reg-lookup-name r "c++ header") 0))
           (assert-eq (registry/reg-lookup-name r "nope-lang") -1)))

(deftest override-shadows-builtin
         (let [r (fresh)
               a (alloc/malloc-allocator)
               custom
                 (lang/lang-from-strings a "MyPython" "#" "" false "\"'" "")]
           (registry/reg-add! r custom "py")
           (let [idx (registry/reg-lookup-path r "x.py")]
             (assert (= (.name (registry/reg-spec r idx)) "MyPython")))))

(deftest dotfile-is-not-extension
         (let [r (fresh)]
           ;; .gitignore should not match a "gitignore" extension nor crash
           (assert-eq (registry/reg-lookup-path r ".gitignore") -1)))

(deftest extension-filter-restricts-lookup
         (let [r (fresh)]
           (registry/reg-restrict-extensions! r "PY, c")
           (assert (>= (registry/reg-lookup-path r "lib/module.py") 0))
           (assert (>= (registry/reg-lookup-path r "src/MAIN.C") 0))
           (assert-eq (registry/reg-lookup-path r "src/main.rs") -1)
           (assert-eq (registry/reg-lookup-path r "Makefile") -1)))

(deftest nim-nested-block-vs-line
         ;; #[ must win over # so nested block comments count as comments
         (let [r (fresh)
               idx (registry/reg-lookup-name r "nim")
               src "#[ outer\n#[ inner ]#\nstill comment ]#\nx = 1\n"
               c (counter/count-bytes (registry/reg-spec r idx) src)]
           (assert-eq (.comments c) 3)
           (assert-eq (.code c) 1)))

(deftest lua-block-vs-line
         (let [r (fresh)
               idx (registry/reg-lookup-name r "lua")
               src "--[[ block\nstill ]]\nx = 1 -- line\n-- whole line\n"
               c (counter/count-bytes (registry/reg-spec r idx) src)]
           (assert-eq (.comments c) 3)
           (assert-eq (.code c) 1)))

(deftest assembly-slash-comments
         (let [r (fresh)
               idx (registry/reg-lookup-name r "Assembly")
               c
                 (counter/count-bytes (registry/reg-spec r idx)
                                      "// heading\nmov %eax, %ebx // tail\n; another comment\n")]
           (assert-eq (.lines c) 3)
           (assert-eq (.code c) 1)
           (assert-eq (.comments c) 2)))

(deftest shell-and-rust-multiline-strings
         (let [r (fresh)
               sh (registry/reg-lookup-name r "Shell")
               rs (registry/reg-lookup-name r "Rust")
               shell-count
                 (counter/count-bytes (registry/reg-spec r sh)
                                      "value=\"first\n\n# data\nlast\"\n# comment\n")
               rust-count
                 (counter/count-bytes (registry/reg-spec r rs)
                                      "let s = \"first\n/// data\nlast\";\n// comment\n")]
           (assert (= (.shell-heredocs (registry/reg-spec r sh)) true))
           (assert-eq (load (index (load (field (registry/reg-spec r sh)
                                                classes))
                                   #\<))
                      (cast u8 lang/CLS-HOT))
           (assert-eq (.lines shell-count) 5)
           (assert-eq (.code shell-count) 4)
           (assert-eq (.comments shell-count) 1)
           (assert-eq (.lines rust-count) 4)
           (assert-eq (.code rust-count) 3)
           (assert-eq (.comments rust-count) 1)))

(deftest rust-character-literals-and-lifetimes
         (let [r (fresh)
               rs (registry/reg-lookup-name r "Rust")
               c
                 (counter/count-bytes (registry/reg-spec r rs)
                                      "let c = '\"';\n// comment\nlet q = '\\'';\nfn f<'a>(x: &'a str) {} // tail\n")]
           (assert-eq (.lines c) 4)
           (assert-eq (.code c) 3)
           (assert-eq (.comments c) 1)))

(deftest shell-escaped-quote-outside-string
         (let [r (fresh)
               sh (registry/reg-lookup-name r "Shell")
               c
                 (counter/count-bytes (registry/reg-spec r sh)
                                      "value=${value//\\\"/}\n\n# real comment\n")]
           (assert-eq (.lines c) 3)
           (assert-eq (.code c) 1)
           (assert-eq (.blank c) 1)
           (assert-eq (.comments c) 1)))

;; --- --dirs rollup keys -----------------------------------------------------
;; --dirs keeps one row per (directory, language), so the rollup key has to
;; separate the two halves unambiguously — otherwise a directory whose name
;; ends where a language name begins would merge two different rows.
(deftest dir-lang-key-separates-halves
         (let [a (alloc/malloc-allocator)]
           (assert (= (dir-lang-key a "src" "C") (dir-lang-key a "src" "C")))
           (assert (= (= (dir-lang-key a "src" "C")
                         (dir-lang-key a "src" "C++"))
                      false))
           (assert (= (= (dir-lang-key a "src" "C") (dir-lang-key a "srcC" ""))
                      false))
           (assert (= (= (dir-lang-key a "a/b" "Go")
                         (dir-lang-key a "a" "b/Go"))
                      false))))

(deftest dir-lang-key-handles-root-and-empty
         (let [a (alloc/malloc-allocator)]
           (assert (= (len (dir-lang-key a "." "Markdown")) 10))
           (assert (= (= (dir-lang-key a "." "C") (dir-lang-key a "." "D"))
                      false))))

(deftest dir-rollup-key-depth
         (assert (= (dir-rollup-key "a/b/c" 0 1) "a"))
         (assert (= (dir-rollup-key "a/b/c" 0 2) "a/b"))
         (assert (= (dir-rollup-key "a/b/c" 0 9) "a/b/c"))
         (assert (= (dir-rollup-key "" 0 1) ".")))

;; depth is counted from the walk root, so `thecount src` groups by src's own
;; subdirectories rather than putting everything in one "src" row
(deftest dir-rollup-key-root-relative
         (assert (= (dir-rollup-key "src" 3 1) "src"))
         (assert (= (dir-rollup-key "src/bus" 3 1) "src/bus"))
         (assert (= (dir-rollup-key "src/bus/cc" 3 1) "src/bus"))
         (assert (= (dir-rollup-key "src/bus/cc" 3 2) "src/bus/cc"))
         (assert (= (dir-rollup-key "a/b/c" 3 1) "a/b/c")))

(deftest dir-row-key-makes-named-root-explicit
         (let [a (alloc/malloc-allocator)]
           (assert (= (dir-row-key a "src" 3 1) "src/."))
           (assert (= (dir-row-key a "src/bus" 3 1) "src/bus"))
           (assert (= (dir-row-key a "" 0 1) "."))))

(defn roots3 [(a (dyn alloc/Allocator))
              (x (slice u8))
              (y (slice u8))
              (z (slice u8))] (-> (ptr (arraylist/ArrayList (slice u8))))
  (let [l
          (alloc/box! a
                      (arraylist/ArrayList (slice u8))
                      (arraylist/al-new [(slice u8)] a))]
    (push! l x)
    (push! l y)
    (push! l z)
    l))

(deftest dir-base-len-longest-component-match
         (let [a (alloc/malloc-allocator)
               rs (roots3 a "src" "src/bus" "vendor")]
           (assert-eq (dir-base-len rs "src") 3)
           (assert-eq (dir-base-len rs "src/tui") 3)
           (assert-eq (dir-base-len rs "src/bus/cc") 7)
           (assert-eq (dir-base-len rs "srcX/y") 0)
           (assert-eq (dir-base-len rs "other") 0)))

(deftest walk-roots-dot-becomes-empty
         (let [a (alloc/malloc-allocator)
               w (walk-roots-of a (roots3 a "." "src" "vendor"))]
           (assert-eq (len (get (load w) 0)) 0)
           (assert (= (get (load w) 1) "src"))
           (assert-eq (dir-base-len w "anything/here") 0)))

(deftest fortran-2008-extension
         (let [r (fresh)
               idx (registry/reg-lookup-path r "fixture.f08")]
           (assert (>= idx 0))
           (assert (= (.name (registry/reg-spec r idx)) "Fortran"))
           (assert-eq idx (registry/reg-lookup-path r "fixture.F08"))))
