(module thecount.simd)

;; Vector byte classification, simdjson-style.
;;
;; The scalar scan in count-bytes costs one byte-class table load per byte, and
;; that load is the whole cost of counting: on a 4.2 MB C++ corpus only 1.24% of
;; bytes are delimiters, so 98.8% of the work is "is this byte interesting, and
;; is it whitespace" — one byte at a time, as a serial dependency chain.
;;
;; The answer to both questions is a BITMASK. Load a vector, compare against a
;; delimiter, extract one bit per lane, and the whole chunk is answered in a
;; couple of instructions; the scan then jumps straight to the next set bit
;; instead of walking to it. This is the core trick behind simdjson's structural
;; character scan.
;;
;; This used to be a thin (primitive/llvm-ir …) wrapper, written by hand because
;; coil.simd didn't exist yet. It now builds on coil.simd directly: `vloadu`
;; for the unaligned load (these pointers are arbitrary offsets into a file
;; buffer, never guaranteed to be vector aligned), `v=`/`vor`/`byte-in-range?`
;; for the comparisons, and `mask->bits` for lane extraction — which emits the
;; same `bitcast <N x i1> to iN` on both x86 and arm64 that this module used to
;; write directly. `ctz`/`popcount`/`clz` are coil.primitive's scalar ops,
;; confirmed to compile to the identical rbit/clz, cnt/addv, and clz sequences
;; this module's hand-written llvm.cttz/ctpop/ctlz calls did.
;;
;; coil.simd's own `ascii-whitespace?` isn't a direct replacement for the ws
;; masks below: it matches bytes 9-13, which includes newline (10), and a
;; scanned line's newline must stay out of its own whitespace mask. So the ws
;; masks are still written by hand, just from coil.simd pieces instead of raw
;; IR: tab (9) and space (32) by equality, carriage-return/vertical-tab/form-feed
;; (11-13) as one inclusive range that skips 10.
;;
;; The byte operands are compile-time literals at every call site
;; (thecount.specialize generates them), so -O3 inlines these bodies and folds
;; the splat to a constant vector.
(import "coil.simd" :as v)
(import "coil.primitive" :as primitive)

;;; Bit i is set iff the byte at p[i] equals b, for i in 0..15.
(defn v16-eq-mask [(p (ptr u8)) (b i64)] (-> i64)
  (cast i64
        (v/mask->bits (v/v= (v/vloadu [u8 16] p) (v/vsplat [u8 16] (cast u8 b))))))

;;; Bit i is set iff p[i] is horizontal whitespace: space, tab, carriage
;;; return, vertical tab, or form feed. Newline terminates a scanned line.
(defn v16-ws-mask [(p (ptr u8))] (-> i64)
  (let [bytes (v/vloadu [u8 16] p)]
    (cast i64
          (v/mask->bits (v/vor (v/v= bytes (v/vsplat [u8 16] 9))
                               (v/vor (v/byte-in-range? bytes 11 13)
                                      (v/v= bytes (v/vsplat [u8 16] 32))))))))

(defn v32-eq-mask [(p (ptr u8)) (b i64)] (-> i64)
  (cast i64
        (v/mask->bits (v/v= (v/vloadu [u8 32] p) (v/vsplat [u8 32] (cast u8 b))))))

(defn v32-ws-mask [(p (ptr u8))] (-> i64)
  (| (v16-ws-mask p)
     (<< (v16-ws-mask (index p 16)) 16)))

(defn v64-eq-mask [(p (ptr u8)) (b i64)] (-> i64)
  (cast i64
        (v/mask->bits (v/v= (v/vloadu [u8 64] p) (v/vsplat [u8 64] (cast u8 b))))))

(defn v64-ws-mask [(p (ptr u8))] (-> i64)
  (let [bytes (v/vloadu [u8 64] p)]
    (cast i64
          (v/mask->bits (v/vor (v/v= bytes (v/vsplat [u8 64] 9))
                               (v/vor (v/byte-in-range? bytes 11 13)
                                      (v/v= bytes (v/vsplat [u8 64] 32))))))))

;;; Index of the lowest set bit. Only called on a non-zero mask.
(defn ctz [(x i64)] (-> i64)
  (primitive/ctz x))

;;; Find the next physical newline without a libc call for each source line.
(defn find-newline [(data (ptr u8)) (start i64) (len i64)] (-> i64)
  (let [(mut p) start]
    (block :found
           (while (<= (+ p 64) len)
             (let [mask (v64-eq-mask (index data p) #\newline)]
               (when (!= mask 0)
                 (return-from :found (+ p (ctz mask))))
               (set! (mut p) (+ p 64))))
           (while (<= (+ p 32) len)
             (let [mask (v32-eq-mask (index data p) #\newline)]
               (when (!= mask 0)
                 (return-from :found (+ p (ctz mask))))
               (set! (mut p) (+ p 32))))
           (while (<= (+ p 16) len)
             (let [mask (v16-eq-mask (index data p) #\newline)]
               (when (!= mask 0)
                 (return-from :found (+ p (ctz mask))))
               (set! (mut p) (+ p 16))))
           (while (< p len)
             (when (= (cast i64 (load (index data p))) #\newline)
               (return-from :found p))
             (set! (mut p) (+ p 1)))
           len)))

(defn popcount [(x i64)] (-> i64)
  (primitive/popcount x))

(defn clz [(x i64)] (-> i64)
  (primitive/clz x))
