(module thecount.lang)
(import "coil.slice" :as slice)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.str" :as str)
(import "coil.os" :as os)
(import "coil.mem" :use [mem-fill])
(import "thecount.util" :as util)

;;; One block-comment delimiter pair, e.g. "/*" and "*/".
(defstruct BlockPair [(bstart (slice u8)) (bend (slice u8))])

;;; Everything the counter needs to know about a language.
;;; quotes: each byte is a single-char string delimiter (' " `).
;;; multi-quotes: multi-char string delimiters that may span lines (Python """).
(defstruct LangSpec
  [(name (slice u8))
   (line-comments (slice (slice u8)))
   (blocks (slice BlockPair))
   (nested bool)
   (quotes (slice u8))
   (multiline-quote-chars (slice u8))
   (single-scalar-char-literals bool)
   (shell-heredocs bool)
   (multi-quotes (slice (slice u8)))
   (classes (ptr u8))])  ; 256-entry byte-class table, see rebuild-classes!

(const CLS-PLAIN 0)

(const CLS-WS 2)

(const CLS-HOT 3)  ; byte can start a comment/string token: leave the fast path

;;; Split s on runs of spaces into freshly allocated token slices (views into s).
(defn split-tokens [(a (dyn alloc/Allocator)) (s (slice u8))] (-> (slice (slice u8)))
  (let [pieces (str/str-split a s " ")
        n (len pieces)
        (mut count) 0]
    (for piece
      (iter pieces)
      (when (> (len piece) 0)
        (set! (mut count) (+ count 1))))
    (let [out (util/must-alloc [(slice u8)] a count)
          (mut w) 0]
      (for piece
        (iter pieces)
        (when (> (len piece) 0)
          (set! (index out w) piece)
          (set! (mut w) (+ w 1))))
      (slice/slice-new out count))))

;;; Parse "START END START END ..." into block pairs. An odd trailing token is
;;; a configuration error and aborts with a message.
(defn parse-blocks [(a (dyn alloc/Allocator)) (s (slice u8))] (-> (slice BlockPair))
  (let [toks (split-tokens a s)
        n (len toks)]
    (when (!= (% n 2) 0)
      (println "thecount: block comment tokens must come in start/end pairs: {s}"
               s)
      (os/_exit 2)
      0)
    (let [np (/ n 2)
          out (util/must-alloc [BlockPair] a np)]
      (for [k 0 np]
        (set! (index out k)
              (BlockPair :bstart (get toks (* k 2))
                :bend (get toks (+ (* k 2) 1)))))
      (slice/slice-new out np))))

;;; Build a LangSpec from space-separated token strings — the exact same
;;; format the user config file and `thecount add-lang` use.
;;;   lcs:    "// #"        line comment starters
;;;   blocks: "/* */"       block pairs, start end start end
;;;   quotes: "\"'"         each BYTE is a single-char string delimiter
;;;   mqs:    "\"\"\" '''"  multiline string delimiters
(defn lang-from-strings [(a (dyn alloc/Allocator))
                         (name (slice u8))
                         (lcs (slice u8))
                         (blocks (slice u8))
                         (nested bool)
                         (quotes (slice u8))
                         (mqs (slice u8))] (-> LangSpec)
  (let [(mut l)
          (util/zeroed-with LangSpec
                            (name name)
                            (line-comments (split-tokens a lcs))
                            (blocks (parse-blocks a blocks))
                            (nested nested)
                            (quotes quotes)
                            (multiline-quote-chars "")
                            (single-scalar-char-literals false)
                            (shell-heredocs false)
                            (multi-quotes (split-tokens a mqs)))]
    (rebuild-classes! a (mut l))
    l))

;;; (Re)build the byte-class table from the token fields. Must be called
;;; whenever line-comments/blocks/quotes/multi-quotes change.
(defn rebuild-classes! [(a (dyn alloc/Allocator)) (l (mut LangSpec))] (-> i64)
  (let [t (util/must-alloc [u8] a 256)]
    (mem-fill t (cast u8 CLS-PLAIN) 256)
    (set! (index t #\space) (cast u8 CLS-WS))
    (set! (index t #\tab) (cast u8 CLS-WS))
    (set! (index t #\return) (cast u8 CLS-WS))
    (set! (index t 11) (cast u8 CLS-WS))  ; vertical tab
    (set! (index t 12) (cast u8 CLS-WS))  ; form feed
    (let [lcs (.line-comments (mut l))]
      (for lc
        (iter lcs)
        (set! (index t (cast i64 (get lc 0))) (cast u8 CLS-HOT))))
    (let [bls (.blocks (mut l))]
      (for block
        (iter bls)
        (let [(mut b) block]
          (set! (index t
                       (cast i64 (get (load (field (mut b) bstart)) 0)))
                (cast u8 CLS-HOT)))))
    (let [mqs (.multi-quotes (mut l))]
      (for mq
        (iter mqs)
        (set! (index t (cast i64 (get mq 0))) (cast u8 CLS-HOT))))
    (let [qs (.quotes (mut l))]
      (for q
        (iter qs)
        (set! (index t (cast i64 q)) (cast u8 CLS-HOT))))
    (when (= (.shell-heredocs (mut l)) true)
      (set! (index t #\<) (cast u8 CLS-HOT))
      (set! (index t #\$) (cast u8 CLS-HOT))
      (set! (index t #\() (cast u8 CLS-HOT))
      (set! (index t #\)) (cast u8 CLS-HOT))
      0)
    (set! (.classes (mut l)) t)
    0))
