(module thecount.registry)

(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.str" :use *)
(import "thecount.lang" :use *)

(defstruct Registry
  [(arena (ptr Allocator))
   (specs (ptr (ArrayList LangSpec)))
   (by-ext (ptr (HashMap (slice u8) i64)))
   (by-name (ptr (HashMap (slice u8) i64)))
   (by-file (ptr (HashMap (slice u8) i64)))])

(defn lower [(a (ptr Allocator)) (s (slice u8))] (-> (slice u8))
  (let [n (slice-len s)
        p (unwrap-ptr [u8] (alloc-slice [u8] a n))
        (mut k) 0]
    (while (< k n)
      (let [b (cast i64 (slice-get s k))]
        (if (and (>= b \A) (<= b \Z))
            (store! (index p k) (cast u8 (+ b 32)))
            (store! (index p k) (slice-get s k))))
      (store! (mut k) (+ k 1)))
    (slice-new p n)))

(defn reg-new [(a (ptr Allocator))] (-> (ptr Registry))
  (let [r (unwrap-ptr [Registry] (create [Registry] a))
        specs (unwrap-ptr [(ArrayList LangSpec)] (create [(ArrayList LangSpec)] a))
        by-ext (unwrap-ptr [(HashMap (slice u8) i64)] (create [(HashMap (slice u8) i64)] a))
        by-name (unwrap-ptr [(HashMap (slice u8) i64)] (create [(HashMap (slice u8) i64)] a))
        by-file (unwrap-ptr [(HashMap (slice u8) i64)] (create [(HashMap (slice u8) i64)] a))]
    (store! specs (al-new [LangSpec] a))
    (store! by-ext (hm-new [(slice u8) i64] a (str-keyops)))
    (store! by-name (hm-new [(slice u8) i64] a (str-keyops)))
    (store! by-file (hm-new [(slice u8) i64] a (str-keyops)))
    (store! (field r arena) a)
    (store! (field r specs) specs)
    (store! (field r by-ext) by-ext)
    (store! (field r by-name) by-name)
    (store! (field r by-file) by-file)
    r))

;; Register a language spec under space-separated extensions.
;; Re-registering an extension or name overrides the previous mapping,
;; which is how user languages shadow builtins. Returns the spec index.
(defn reg-add! [(r (ptr Registry)) (spec LangSpec) (exts (slice u8))] (-> i64)
  (let [a (load (field r arena))
        specs (load (field r specs))
        idx (al-len specs)]
    (al-push! specs spec)
    (hm-put! (load (field r by-name)) (lower a (load (field spec name))) idx)
    (let [toks (split-tokens a exts)
          n (slice-len toks)
          (mut k) 0]
      (while (< k n)
        (hm-put! (load (field r by-ext)) (lower a (slice-get toks k)) idx)
        (store! (mut k) (+ k 1))))
    idx))

;; Map extra space-separated extensions onto an existing spec index.
(defn reg-add-ext! [(r (ptr Registry)) (idx i64) (exts (slice u8))] (-> i64)
  (let [a (load (field r arena))
        toks (split-tokens a exts)
        n (slice-len toks)
        (mut k) 0]
    (while (< k n)
      (hm-put! (load (field r by-ext)) (lower a (slice-get toks k)) idx)
      (store! (mut k) (+ k 1)))
    0))

;; Map exact (space-separated) filenames like Makefile to a spec index.
(defn reg-add-files! [(r (ptr Registry)) (idx i64) (names (slice u8))] (-> i64)
  (let [a (load (field r arena))
        toks (split-tokens a names)
        n (slice-len toks)
        (mut k) 0]
    (while (< k n)
      (hm-put! (load (field r by-file)) (slice-get toks k) idx)
      (store! (mut k) (+ k 1)))
    0))

(defn reg-spec [(r (ptr Registry)) (idx i64)] (-> (ptr LangSpec))
  (index (slice-data (al-slice (load (load (field r specs))))) idx))

(defn reg-count [(r (ptr Registry))] (-> i64)
  (al-len (load (field r specs))))

;; Spec index for a language name (case-insensitive), or -1.
(defn reg-lookup-name [(r (ptr Registry)) (name (slice u8))] (-> i64)
  (match (hm-get (load (load (field r by-name))) (lower (load (field r arena)) name))
    (Some [v] v)
    (None [] -1)))

;; Spec index for a file path: exact basename match first, then the
;; (lowercased) extension after the last dot. -1 when unknown.
(defn reg-lookup-path [(r (ptr Registry)) (path (slice u8))] (-> i64)
  (let [n (slice-len path)
        (mut k) (- n 1)
        (mut slash) -1]
    (while (and (>= k 0) (= slash -1))
      (when (= (cast i64 (slice-get path k)) \/)
        (store! (mut slash) k))
      (store! (mut k) (- k 1)))
    (let [base (subslice path (+ slash 1) n)]
      (match (hm-get (load (load (field r by-file))) base)
        (Some [v] v)
        (None []
              (let [bn (slice-len base)
                    (mut j) (- bn 1)
                    (mut dot) -1]
                (while (and (> j 0) (= dot -1))
                  (when (= (cast i64 (slice-get base j)) \.)
                    (store! (mut dot) j))
                  (store! (mut j) (- j 1)))
                (if (<= dot 0)
                    -1
                    (let [ext (subslice base (+ dot 1) bn)]
                      (match (hm-get (load (load (field r by-ext)))
                                     (lower (load (field r arena)) ext))
                        (Some [v] v)
                        (None [] -1))))))))))

;; --- builtin language table -------------------------------------------------
;; One line per language: name, extensions, line comments, block pairs,
;; nested blocks?, quote chars, multiline string tokens.

(defn add-builtin! [(r (ptr Registry))
                    (name (slice u8))
                    (exts (slice u8))
                    (lcs (slice u8))
                    (blocks (slice u8))
                    (nested bool)
                    (quotes (slice u8))
                    (mqs (slice u8))] (-> i64)
  (reg-add! r (lang-from-strings (load (field r arena)) name lcs blocks nested quotes mqs) exts))

(defn add-builtins! [(r (ptr Registry))] (-> i64)
  (add-builtin! r "C" "c" "//" "/* */" false "\"'" "")
  (add-builtin! r "C Header" "h" "//" "/* */" false "\"'" "")
