(module countbench)

;; Counter-only microbenchmark: run BOTH scanners over the same file and report
;; throughput for each. End-to-end `thecount` timings are dominated by the
;; reader's syscalls, so this is the only honest way to see what compile-time
;; specialization actually bought the scan itself.
;;
;;   coil run src/countbench.coil -- path/to/file.cpp
;;
;; The language comes from the path, exactly as the real walk resolves it. A
;; file whose language has no generated scanner reports the same number twice.

(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.fs" :use *)
(import "coil.str" :use *)
(import "coil.time" :as time)
(import "thecount.lang" :use *)
(import "thecount.counter" :use *)
(import "thecount.registry" :use *)

(const REPS 40)

(defn now-ms [] (-> i64)
  (match (time/monotonic-now-ms) (Ok [v] v) (Err [_] 0)))

;; MB/s for `reps` passes over `data`, using the interpreter when `use-generic`.
(defn bench [(r (ptr Registry)) (idx i64) (data (slice u8)) (use-generic bool)] (-> i64)
  (let [t0 (now-ms)
        (mut k) 0
        (mut sink) 0]
    (while (< k REPS)
      (let [c
              (if use-generic
                  (count-bytes (reg-spec r idx) data)
                  (reg-count-bytes r idx data))]
        (store! (mut sink) (+ sink (load (field c lines)))))
      (store! (mut k) (+ k 1)))
    (let [ms (- (now-ms) t0)
          total-mb (/ (* (slice-len data) REPS) 1048576)]
      (println "  {d} lines/pass, {d} ms, {d} MB/s"
               (/ sink REPS)
               ms
               (/ (* total-mb 1000) (if (= ms 0) 1 ms)))
      ms)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (< (cast i64 argc) 2)
      (do (println "usage: countbench <file>") 1)
      (let [a (malloc-allocator)
            path (cstr->str (load (index argv 1)))
            r (reg-new a)]
        (add-builtins! r)
        (let [idx (reg-lookup-path r path)]
          (if (= idx -1)
              (do (println "countbench: no language for {s}" path) 1)
              (match (read-file a path)
                (Err [_] (do (println "countbench: cannot read {s}" path) 1))
                (Ok [data]
                    (let [spec (reg-spec r idx)]
                      (println "{s}: {d} bytes as {s}"
                               path
                               (slice-len data)
                               (load (field spec name)))
                      (println "interpreter (count-bytes):")
                      (let [g (bench r idx data true)]
                        (println "specialized:")
                        (let [s (bench r idx data false)]
                          (println "specialized takes {d}% of interpreter time"
                                   (/ (* s 100) (if (= g 0) 1 g)))
                          0))))))))))
