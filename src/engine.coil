(module thecount.engine)
(import "coil.slice" :as slice)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.hashmap" :as hashmap)
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.io" :use [read stderr write-line])
(import "coil.os" :as os)
(import "coil.thread" :as thread)
(import "coil.atomic" :as atomic)
(import "coil.mem" :use [mem-copy mem-zero])
(import "thecount.lang" :as lang)
(import "thecount.registry" :as registry)
(import "thecount.counter" :as counter)
(import "thecount.walk" :as walk)
(import "thecount.ignore" :as ignore)
(import "thecount.output" :use [Row mk-row i64->str])
(import "thecount.util" :as util)

(extern openat :cc c [i32 (ptr i8) i32] (-> i32))

(extern dirfd :cc c [(ptr i8)] (-> i32))

(extern pthread_mutex_init :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern pthread_mutex_lock :cc c [(ptr i8)] (-> i32))

(extern pthread_mutex_unlock :cc c [(ptr i8)] (-> i32))

(extern pthread_mutex_destroy :cc c [(ptr i8)] (-> i32))

(extern pthread_cond_init :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern pthread_cond_wait :cc c [(ptr i8) (ptr i8)] (-> i32))

(extern pthread_cond_signal :cc c [(ptr i8)] (-> i32))

(extern pthread_cond_broadcast :cc c [(ptr i8)] (-> i32))

(extern pthread_cond_destroy :cc c [(ptr i8)] (-> i32))

(extern access :cc c [(ptr i8) i32] (-> i32))

(extern sysconf :cc c [i32] (-> i64))

(extern unshare :cc c [i32] (-> i32))

(const CLONE-FILES 1024)

(defstruct ClockTime [(seconds i64) (nanoseconds i64)])

(extern clock_gettime :cc c [i32 (ptr ClockTime)] (-> i32))

(defn now-ns [] (-> i64)
  (let [(mut t) (zeroed ClockTime)]
    (clock_gettime (cast i32 (fs/os-pick 1 6)) (mut t))
    (+ (* (.seconds (mut t)) 1000000000) (.nanoseconds (mut t)))))

;; Workers share a directory queue. Each worker reads and counts files into a
;; private aggregate, then the main thread merges those aggregates. Keeping
;; the read and scan on one worker avoids a per-file handoff and lets each
;; worker reuse its file buffer.

;;; Reusable file buffer: grows to the largest file seen.
(defstruct ReadBuf [(p (ptr u8)) (cap i64)])

(defn rb-new [(a (dyn alloc/Allocator))] (-> (ptr ReadBuf))
  (alloc/box! a ReadBuf (ReadBuf :p (cast (ptr u8) 0) :cap 0)))

;;; Grow rb to at least newcap bytes, preserving bytes already read.
;;; Buffer memory ALWAYS comes from the global malloc allocator: buffers are
;;; shared across threads, and freeing one arena's region pointer through
;;; another arena's free hook aborts (libmalloc: pointer was not allocated).
(defn rb-grow! [(a (dyn alloc/Allocator)) (rb (ptr ReadBuf)) (newcap i64)] (-> i64)
  (let [ma (alloc/malloc-allocator)
        old (alloc/alloc-slice-new (.p rb) (.cap rb))]
    (match (alloc/reallocate [u8] ma old newcap)
      (Some [memory]
            (do
              (set! (.p rb) (alloc/alloc-slice-data memory))
              (set! (.cap rb) newcap)
              0))
      (None [] (alloc/oom-at c"read buffer" newcap)))
    0))

;;; Read a file into rb's buffer. Returns bytes read or -1. A short read is
;;; allowed for regular files, so only a zero read means EOF.
(defn read-into! [(a (dyn alloc/Allocator)) (rb (ptr ReadBuf)) (cpath (ptr i8))] (-> i64)
  (read-fd-into! a rb (os/open cpath 0)))

;;; openat variant: resolve name relative to dfd — one path component of
;;; kernel name lookup instead of the whole path.
(defn read-into-at! [(a (dyn alloc/Allocator))
                     (rb (ptr ReadBuf))
                     (dfd i32)
                     (cname (ptr i8))] (-> i64)
  (read-fd-into! a rb (openat dfd cname (cast i32 (fs/os-pick 131072 256)))))

(defn read-fd-into! [(a (dyn alloc/Allocator)) (rb (ptr ReadBuf)) (fd i32)] (-> i64)
  (if (< (cast i64 fd) 0)
      -1
      (let [(mut got) 0
            (mut done) false
            (mut failed) false]
        (when (= (.cap rb) 0)
          (rb-grow! a rb 4194304)
          0)
        (while (= done false)
          (let [want (- (.cap rb) got)]
            (when (< want 65536)
              ;; buffer full: double it and continue after bytes already read.
              (rb-grow! a rb (* (.cap rb) 2))
              0)
            (let [n
                    (read fd
                          (cast (ptr i8) (index (load (field rb p)) got))
                          (- (.cap rb) got))]
              (cond (< (cast i64 n) 0)
                      (when (!= (os/os-errno) 4)
                        (set! (mut failed) true)
                        (set! (mut done) true)
                        0)
                    (= (cast i64 n) 0) (set! (mut done) true)
                    :else (set! (mut got) (+ got (cast i64 n)))))))
        (os/close fd)
        (if (= failed true) -1 got))))

;;; Aggregation state; each counter owns one, merged after the pools drain.
(defstruct Agg
  [(files-per (slice i64))  ; per-spec-index file count
   (counts-per (slice counter/Counts))  ; per-spec-index line counts
   (file-rows (ptr (arraylist/ArrayList Row)))
   (want-files bool)
   (dir-rows (ptr (arraylist/ArrayList Row)))
   (dir-idx (ptr (hashmap/HashMap (slice u8) i64)))
   (want-dirs bool)
   (depth i64)
   (roots (ptr (arraylist/ArrayList (slice u8))))])  ; walk roots, for root-relative depth

;;; Immutable chain of .gitignore contexts, innermost first. Built during the
;;; walk, only ever read afterwards, so it is safe to share across workers.
(defstruct CtxNode [(ctx ignore/IgnoreCtx) (parent (ptr CtxNode))])

;;; A walk item: a directory to walk (files empty), or a batch of
;;; already-filtered file basenames within dir `path` (files non-empty).
(defstruct FileItem [(name (slice u8)) (spec-index i64)])

(defstruct DirItem
  [(path (slice u8))
   (chain (ptr CtxNode))
   (files (slice FileItem))])

(const FILE-BATCH 16)

(defstruct Pool
  [(mutex (array u8 64))  ; guards queue (pthread_mutex_t is <= 64 bytes)
   (qcond (array u8 64))
   (scond (array u8 64))  ; wakes the thread-creation coordinator
   (max-workers i64)
   (wanted-workers i64)  ; guarded by mutex
   (file-tasks i64)  ; queued or active batches, guarded by mutex
   (queue (ptr (arraylist/ArrayList DirItem)))
   (in-flight (ptr i64))  ; guarded by mutex
   (r (ptr registry/Registry))
   (hidden bool)
   (use-ignore bool)  ; any ignore file is consulted (.gitignore or ignore-file)
   (gitignore bool)  ; .gitignore files are honored
   (ignore-file (slice u8))  ; extra per-directory ignore file name, "" = none
   (excludes (ptr (arraylist/ArrayList (slice u8))))
   (timing bool)
   (io-ns (ptr i64))
   (scan-ns (ptr i64))
   (walk-ns (ptr i64))
   (worker-ns (ptr i64))])

(defstruct WorkerArg
  [(pool (ptr Pool)) (agg (ptr Agg)) (active-ns i64) (items i64)])

(defn new-agg [(a (dyn alloc/Allocator))
               (keyops (ptr hashmap/KeyOps))
               (n-specs i64)
               (want-files bool)
               (want-dirs bool)
               (depth i64)
               (roots (ptr (arraylist/ArrayList (slice u8))))] (-> (ptr Agg))
  (let [files-per (util/must-alloc [i64] a n-specs)
        counts-per (util/must-alloc [counter/Counts] a n-specs)
        file-rows (util/new-list a Row)
        dir-rows (util/new-list a Row)
        dir-idx (util/new-map a (slice u8) i64 keyops)]
    (mem-zero files-per n-specs)
    (mem-zero counts-per n-specs)
    (alloc/box! a
                Agg
                (Agg
                  :files-per (slice/slice-new files-per n-specs)
                  :counts-per (slice/slice-new counts-per n-specs)
                  :file-rows file-rows
                  :want-files want-files
                  :dir-rows dir-rows
                  :dir-idx dir-idx
                  :want-dirs want-dirs
                  :depth depth
                  :roots roots))))

;;; NUL byte in the first 8000 bytes = binary, skip it (same heuristic as scc).
(defn binary? [(data (slice u8))] (-> bool)
  (let [n (len data)
        lim (if (< n 8000) n 8000)]
    (< (counter/find-byte data 0 lim 0) lim)))

;;; Length of the longest walk root `dir` sits under, or 0 for none. Depth is
;;; counted from there, so `thecount src --dirs` breaks src up by ITS own
;;; subdirectories instead of collapsing everything under one "src" row.
;;; A "." root walks with an empty prefix, which lands on 0 by itself.
(defn dir-base-len [(roots (ptr (arraylist/ArrayList (slice u8))))
                    (dir (slice u8))] (-> i64)
  (let [n (len (load roots))
        dn (len dir)
        (mut best) 0]
    (for [i 0 n]
      (let [rt (get (load roots) i)
            rn (len rt)]
        (when (and (> rn best) (<= rn dn))
          ;; a root matches only on a whole path component, so "srcX" is
          ;; never treated as living under the root "src"
          (let [bounded (if (= rn dn) true (= (cast i64 (get dir rn)) #\/))]
            (when (and (= bounded true) (= (slice/subslice dir 0 rn) rt))
              (set! (mut best) rn)
              0)
            0)
          0)))
    best))

;;; Rollup key for a directory: its first `depth` segments below the walk root
;;; that starts it (`base` bytes long), labeled with the full path so rows stay
;;; unambiguous across several roots. "." for the walk root itself under ".".
(defn dir-rollup-key [(dir (slice u8)) (base i64) (depth i64)] (-> (slice u8))
  (let [dn (len dir)]
    (cond (= dn 0) "."
          (<= dn base) dir  ; the root directory itself
          :else
            (let [start (if (= base 0) 0 (+ base 1))
                  (mut segs) 0
                  (mut cut) dn
                  (mut j) start
                  (mut done) false]
              (while (and (= done false) (< j dn))
                (when (= (cast i64 (get dir j)) #\/)
                  (set! (mut segs) (+ segs 1))
                  (when (= segs depth)
                    (set! (mut cut) j)
                    (set! (mut done) true)
                    0)
                  0)
                (set! (mut j) (+ j 1)))
              (slice/subslice dir 0 cut)))))

;;; Label files directly inside an explicitly named walk root as "root/.".
;;; Without the dot, a root containing no subdirectories looks like --dirs
;;; merely echoed the argument instead of showing where those files live.
;;; The current-directory root is already displayed as ".".
(defn dir-row-key [(a (dyn alloc/Allocator))
                   (dir (slice u8))
                   (base i64)
                   (depth i64)] (-> (slice u8))
  (if (and (> base 0) (<= (len dir) base))
      (walk/join-path a dir ".")
      (dir-rollup-key dir base depth)))

;;; --dirs keeps one row per (directory, language), so the rollup map is keyed
;;; on both. \x01 is the separator: it cannot occur in a path or in a language
;;; name, so the two halves can never run together to form a colliding key.
(defn dir-lang-key [(a (dyn alloc/Allocator))
                    (dir (slice u8))
                    (lang (slice u8))] (-> (slice u8))
  (let [dn (len dir)
        ln (len lang)
        total (+ (+ dn 1) ln)
        p (util/must-alloc [u8] a total)]
    (mem-copy p (slice/slice-data dir) dn)
    (set! (index p dn) (cast u8 1))
    (mem-copy (index p (+ dn 1)) (slice/slice-data lang) ln)
    (slice/slice-new p total)))

;;; Record counted results for one file into agg.
(defn agg-file! [(a (dyn alloc/Allocator))
                 (r (ptr registry/Registry))
                 (agg (ptr Agg))
                 (idx i64)
                 (dir (slice u8))
                 (name (slice u8))
                 (c counter/Counts)] (-> i64)
  (set! (index (slice/slice-data (load (field agg files-per))) idx)
        (+ (load (index (slice/slice-data (load (field agg files-per))) idx)) 1))
  (counter/counts-add! (index (slice/slice-data (.counts-per agg)) idx) c)
  (when (= (.want-files agg) true)
    (push! (load (field agg file-rows))
           (mk-row (walk/join-path a dir name)
                   (.name (registry/reg-spec r idx))
                   1
                   c))
    0)
  (when (= (.want-dirs agg) true)
    (let [base (dir-base-len (load (field agg roots)) dir)
          dkey (dir-row-key a dir base (.depth agg))
          lang (.name (registry/reg-spec r idx))
          key (dir-lang-key a dkey lang)
          dmap (load (field agg dir-idx))
          drows (load (field agg dir-rows))]
      (match (get (load dmap) key)
        (Some [di]
              (let [rowp
                      (index (slice/slice-data (arraylist/al-slice (load drows)))
                             di)]
                (set! (.files rowp) (+ (.files rowp) 1))
                (counter/counts-add! (field rowp c) c)
                0))
        (None []
              (do
                (set! dmap key (len (load drows)))
                (push! drows (mk-row dkey lang 1 c))
                0)))))
  0)

;;; Count one file synchronously (used for plain-file roots on the main thread).
(defn process-file! [(a (dyn alloc/Allocator))
                     (r (ptr registry/Registry))
                     (agg (ptr Agg))
                     (rb (ptr ReadBuf))
                     (path (slice u8))] (-> i64)
  (let [idx (registry/reg-lookup-path r path)]
    (if (= idx -1)
        0
        (let [size (read-into! a rb (str/str->cstr a path))]
          (if (< size 0)
              0
              (let [data (slice/slice-new (load (field rb p)) size)]
                (if (binary? data)
                    0
                    (let [dn (len path)
                          last-slash
                            (util/bytes-last-index-of path (cast u8 #\/))]
                      (agg-file! a
                                 r
                                 agg
                                 idx
                                 (if (= last-slash -1)
                                     ""
                                     (slice/subslice path 0 last-slash))
                                 (slice/subslice path (+ last-slash 1) dn)
                                 (registry/reg-count-bytes r idx data))))))))))

;;; True iff path contains any of the exclude substrings.
(defn excluded? [(excludes (ptr (arraylist/ArrayList (slice u8))))
                 (path (slice u8))] (-> bool)
  (let [n (len (load excludes))
        (mut k) 0
        (mut hit) false]
    (while (and (= hit false) (< k n))
      (match (str/str-find path (get (load excludes) k))
        (Some [_] (set! (mut hit) true))
        (None [] 0))
      (set! (mut k) (+ k 1)))
    (= hit true)))

;;; Verdict for the entry over the ctx chain: 0 no rule matched, 1 ignore,
;;; -1 keep (negated). Outermost rules apply first (recursion to the chain
;;; root), inner and later rules override.
(defn chain-verdict [(node (ptr CtxNode))
                     (path (slice u8))
                     (name (slice u8))
                     (is-dir bool)] (-> i64)
  (if (= (cast i64 node) 0)
      0
      (let [(mut v) (chain-verdict (load (field node parent)) path name is-dir)]
        (let [ctx (field node ctx)
              base (.base ctx)
              bl (len base)
              rel (if (= bl 0) path (slice/subslice path (+ bl 1) (len path)))
              rules (load (field ctx rules))
              nr (len (load rules))]
          (for [ri 0 nr]
            (let [rule
                    (index (slice/slice-data (arraylist/al-slice (load rules)))
                           ri)]
              (when (or (= is-dir true) (= (.dir-only rule) false))
                (let [pat (.pat rule)
                      target (if (= (.anchored rule) true) rel name)
                      hit
                        (if (= (.literal rule) true)
                            (= pat target)
                            (ignore/glob-match pat target))]
                  (when (= hit true)
                    (set! (mut v)
                          (if (= (.negated rule) true) -1 1))
                    0))
                0)))
          v))))

;;; Push ctx onto the chain when it has rules; otherwise keep the chain as is.
(defn extend-chain! [(a (dyn alloc/Allocator))
                     (chain (ptr CtxNode))
                     (ctx ignore/IgnoreCtx)] (-> (ptr CtxNode))
  (if (> (len (load (load (field ctx rules)))) 0)
      (alloc/box! a CtxNode (CtxNode :ctx ctx :parent chain))
      chain))

(defn entry-ignored? [(chain (ptr CtxNode))
                      (path (slice u8))
                      (name (slice u8))
                      (is-dir bool)] (-> bool)
  (= (chain-verdict chain path name is-dir) 1))

(defn pool-push! [(pool (ptr Pool)) (item DirItem)] (-> i64)
  (let [m (cast (ptr i8) (field pool mutex))]
    (pthread_mutex_lock m)
    (let [inflight (load (field pool in-flight))]
      (set! inflight (+ (load inflight) 1)))
    (push! (load (field pool queue)) item)
    (when (> (len (.files item)) 0)
      (set! (.file-tasks pool) (+ (.file-tasks pool) 1))
      (let [demand (* (.file-tasks pool) 2)
            target
              (if (< demand (.max-workers pool)) demand (.max-workers pool))]
        (when (> target (.wanted-workers pool))
          (set! (.wanted-workers pool) target)
          (pthread_cond_signal (cast (ptr i8) (field pool scond))))))
    (pthread_cond_signal (cast (ptr i8) (field pool qcond)))
    (pthread_mutex_unlock m)
    0))

;; --- reader side -----------------------------------------------------------

;;; Read and count one file using the directory's open descriptor.
(defn reader-file! [(a (dyn alloc/Allocator))
                    (pool (ptr Pool))
                    (agg (ptr Agg))
                    (rb (ptr ReadBuf))
                    (dfd i32)
                    (dir (slice u8))
                    (file FileItem)] (-> i64)
  (let [r (load (field pool r))
        name (.name file)
        idx (.spec-index file)]
    (if (= idx -1)
        0
        (let [t0 (if (.timing pool) (now-ns) 0)
              size
                (read-into-at! a rb dfd (cast (ptr i8) (slice/slice-data name)))]
          (when (.timing pool)
            (atomic/atomic-add (load (field pool io-ns)) (- (now-ns) t0))
            0)
          (if (< size 0)
              0
              (let [data (slice/slice-new (load (field rb p)) size)
                    t1 (if (.timing pool) (now-ns) 0)
                    result
                      (if (binary? data)
                          0
                          (agg-file! a
                                     r
                                     agg
                                     idx
                                     dir
                                     name
                                     (registry/reg-count-bytes r idx data)))]
                (when (.timing pool)
                  (atomic/atomic-add (load (field pool scan-ns))
                                     (- (now-ns) t1))
                  0)
                result))))))

;;; Walk one directory: honor .gitignore, queue subdirectories, and either
;;; read the files right here through the open dir fd (small dirs) or hand
;;; batches of basenames to the walk queue for other readers.
;;; Shared entry filter for both enumerators: apply the hidden/.git/dot rules
;;; and gitignore/exclude checks, then queue directories and collect file
;;; basenames. Callers only pass regular files and directories.
(defn classify-entry! [(a (dyn alloc/Allocator))
                       (pool (ptr Pool))
                       (chain (ptr CtxNode))
                       (dir (slice u8))
                       (hidden bool)
                       (use-ignore bool)
                       (names (mut (arraylist/ArrayList FileItem)))
                       (name (slice u8))
                       (is-dir bool)] (-> i64)
  (let [namlen (len name)]
    (if (= namlen 0)
        0
        (let [first-b (cast i64 (get name 0))]
          (cond (= name ".git") 0
                (and (= first-b #\.) (= hidden false)) 0
                (and (= first-b #\.)
                     (or (= namlen 1)
                         (and (= namlen 2)
                              (= (cast i64 (get name 1)) #\.))))
                  0
                (= is-dir true)
                  (let [full (walk/join-path a dir name)]
                    (if (or (excluded? (load (field pool excludes)) full)
                            (and (= use-ignore true)
                                 (entry-ignored? chain full name true)))
                        0
                        (pool-push! pool
                                    (util/zeroed-with DirItem
                                                      (path full)
                                                      (chain chain)))))
                :else
                  (let [idx
                          (registry/reg-lookup-path (load (field pool r)) name)]
                    (when (>= idx 0)
                      ;; Language selection precedes allocation and scheduling.
                      ;; The registry is immutable during the walk; carry its
                      ;; index so readers do not repeat the lookup.
                      (let [needs-path
                              (or use-ignore
                                  (> (len (load (load (field pool excludes))))
                                     0))
                            full (if needs-path (walk/join-path a dir name) "")]
                        (when (and (= (excluded? (load (field pool excludes))
                                                 full)
                                      false)
                                   (or (= use-ignore false)
                                       (= (entry-ignored? chain full name false)
                                          false)))
                          (push! (mut names)
                                 (FileItem :name (walk/copy-str a name)
                                   :spec-index idx))
                          0)))
                    0))))))

;;; readdir enumerator (linux, and the portable fallback).
(defn enum-readdir! [(a (dyn alloc/Allocator))
                     (pool (ptr Pool))
                     (dp (ptr i8))
                     (chain (ptr CtxNode))
                     (dir (slice u8))
                     (hidden bool)
                     (use-ignore bool)
                     (names (mut (arraylist/ArrayList FileItem)))] (-> i64)
  (let [(mut going) true
        dfd (dirfd dp)]
    (while (= going true)
      (let [ent (fs/readdir dp)]
        (if (= (cast i64 ent) 0)
            (do (set! (mut going) false) 0)
            (let [namlen (walk/dirent-name-len ent)
                  reported-type
                    (cast i64
                          (load (cast (ptr u8) (index ent walk/DIRENT-TYPE-OFF))))
                  name
                    (slice/slice-new (cast (ptr u8)
                                           (index ent walk/DIRENT-NAME-OFF))
                                     namlen)
                  dtype
                    (walk/resolved-dirent-type dfd
                                               (cast (ptr i8)
                                                     (index ent
                                                            walk/DIRENT-NAME-OFF))
                                               reported-type)]
              (if (or (= dtype walk/DT-DIR) (= dtype walk/DT-REG))
                  (classify-entry! a
                                   pool
                                   chain
                                   dir
                                   hidden
                                   use-ignore
                                   (mut names)
                                   name
                                   (= dtype walk/DT-DIR))
                  0)))))
    0))

;;; getattrlistbulk enumerator (darwin): batches of entries with name and
;;; object type in one syscall per ~128KB, without creating child vnodes.
;;; Entry layout (4-byte aligned): u32 total length, attribute_set_t (20
;;; bytes, from ATTR_CMN_RETURNED_ATTRS), attrreference_t for ATTR_CMN_NAME
;;; (i32 offset relative to the reference itself, u32 length incl NUL),
;;; u32 ATTR_CMN_OBJTYPE.
(defstruct AttrList
  [(bitmapcount u16)
   (reserved u16)
   (commonattr u32)
   (volattr u32)
   (dirattr u32)
   (fileattr u32)
   (forkattr u32)])

(extern getattrlistbulk :cc c [i32 (ptr AttrList) (ptr u8) i64 u64] (-> i32))

(const ATTR-CMN-RETURNED-ATTRS 2147483648)  ; 0x80000000

(const ATTR-CMN-NAME 1)

(const ATTR-CMN-OBJTYPE 8)

(const VREG 1)

(const VDIR 2)

(const BULK-BUF-SIZE 131072)

(defn enum-bulk! [(a (dyn alloc/Allocator))
                  (pool (ptr Pool))
                  (fd i32)
                  (chain (ptr CtxNode))
                  (dir (slice u8))
                  (hidden bool)
                  (use-ignore bool)
                  (names (mut (arraylist/ArrayList FileItem)))
                  (buf (ptr u8))] (-> i64)
  (fs/os-pick
              ;; linux: never called (readdir path is selected at compile time), and a
              ;; body would fail to link — fail loudly if it is ever reached.
              (do
                (println "thecount: enum-bulk! is darwin-only")
                (os/_exit 70)
                0)
              (let [al
                      (alloc/box! a
                                  AttrList
                                  (AttrList
                                    :bitmapcount (cast u16 5)
                                    :reserved (cast u16 0)
                                    :commonattr
                                      (cast u32
                                            (+ ATTR-CMN-RETURNED-ATTRS
                                               (+ ATTR-CMN-NAME
                                                  ATTR-CMN-OBJTYPE)))
                                    :volattr (cast u32 0)
                                    :dirattr (cast u32 0)
                                    :fileattr (cast u32 0)
                                    :forkattr (cast u32 0)))]
                (let [(mut going) true]
                  (while (= going true)
                    (let [n
                            (cast i64
                                  (getattrlistbulk fd al buf BULK-BUF-SIZE 0))]
                      (if (<= n 0)
                          (do (set! (mut going) false) 0)
                          (let [(mut off) 0
                                (mut e) 0]
                            (while (< e n)
                              (let [entlen
                                      (cast i64
                                            (load (cast (ptr u32)
                                                        (index buf off))))
                                    q
                                      (+ off 24)  ; skip length u32 + attribute_set_t
                                    nameoff
                                      (cast i64
                                            (load (cast (ptr i32) (index buf q))))
                                    rawlen
                                      (cast i64
                                            (load (cast (ptr u32)
                                                        (index buf (+ q 4)))))
                                    objtype
                                      (cast i64
                                            (load (cast (ptr u32)
                                                        (index buf (+ q 8)))))]
                                (when (> rawlen 0)
                                  (let [(mut nl) (- rawlen 1)
                                        base (index buf (+ q nameoff))]
                                    ;; some filesystems pad the name; trim trailing NULs
                                    (while (and (> nl 0)
                                                (= (cast i64
                                                         (load (index base
                                                                      (- nl 1))))
                                                   0))
                                      (set! (mut nl) (- nl 1)))
                                    (when (or (= objtype VREG) (= objtype VDIR))
                                      (classify-entry! a
                                                       pool
                                                       chain
                                                       dir
                                                       hidden
                                                       use-ignore
                                                       (mut names)
                                                       (slice/slice-new base nl)
                                                       (= objtype VDIR))
                                      0)
                                    0)
                                  0)
                                (set! (mut off) (+ off entlen)))
                              (set! (mut e) (+ e 1)))
                            0)))))
                0)))

;;; Walk one directory: honor .gitignore, queue subdirectories, and either
;;; read the files right here through the open dir fd (small dirs) or hand
;;; batches of basenames to the walk queue for other readers.
;;; Enumeration is plain readdir on every platform: getattrlistbulk was tried
;;; (2026-08-04) and cut sys time 35% but nearly DOUBLED wall time on llvm —
;;; the bulk call is synchronously slower than readdir when only names and
;;; types are needed; it only pays when it replaces per-file stat calls.
(defn process-dir! [(a (dyn alloc/Allocator))
                    (pool (ptr Pool))
                    (agg (ptr Agg))
                    (rb (ptr ReadBuf))
                    (item DirItem)] (-> i64)
  (let [dir (.path item)
        (mut chain) (load (field item chain))
        hidden (.hidden pool)
        use-ignore (.use-ignore pool)
        cdir (str/str->cstr a (if (= (len dir) 0) "." dir))
        handle (cast i64 (fs/opendir cdir))]
    (if (= handle 0)
        0
        (let [(mut names) (arraylist/al-new [FileItem] a)]
          (when (= (.gitignore pool) true)
            (set! (mut chain)
                  (extend-chain! a
                                 chain
                                 (ignore/load-ignore-ctx a dir ".gitignore"))))
          ;; Loaded after .gitignore so its rules take precedence.
          (when (> (len (.ignore-file pool)) 0)
            (set! (mut chain)
                  (extend-chain! a
                                 chain
                                 (ignore/load-ignore-ctx a
                                                         dir
                                                         (.ignore-file pool)))))
          (let [t0 (if (.timing pool) (now-ns) 0)]
            (enum-readdir! a
                           pool
                           (cast (ptr i8) handle)
                           chain
                           dir
                           hidden
                           use-ignore
                           (mut names))
            (when (.timing pool)
              (atomic/atomic-add (load (field pool walk-ns)) (- (now-ns) t0))
              0))
          ;; small dirs: read inline through the already-open fd.
          ;; big dirs: share batches of basenames with the walk queue.
          (let [nfl (len names)
                dfd (dirfd (cast (ptr i8) handle))]
            (if (<= nfl FILE-BATCH)
                (for name
                  (iter names)
                  (reader-file! a pool agg rb dfd dir name))
                (let [(mut o) 0]
                  (while (< o nfl)
                    (let [hi (if (< (+ o FILE-BATCH) nfl) (+ o FILE-BATCH) nfl)
                          chunk (util/must-alloc [FileItem] a (- hi o))]
                      (mem-copy chunk
                                (index (slice/slice-data (arraylist/al-slice (load names)))
                                       o)
                                (- hi o))
                      (pool-push! pool
                                  (util/zeroed-with DirItem
                                                    (path dir)
                                                    (files (slice/slice-new chunk
                                                                            (- hi
                                                                               o)))))
                      (set! (mut o) hi)))
                  0)))
          (fs/closedir (cast (ptr i8) handle))
          0))))

;;; Read a queued batch: open its directory once, openat each basename.
(defn process-batch! [(a (dyn alloc/Allocator))
                      (pool (ptr Pool))
                      (agg (ptr Agg))
                      (rb (ptr ReadBuf))
                      (item DirItem)] (-> i64)
  (let [dir (.path item)
        fs (.files item)
        n (len fs)
        dfd (os/open (str/str->cstr a (if (= (len dir) 0) "." dir)) 0)]
    (if (< (cast i64 dfd) 0)
        0
        (let []
          (for name
            (iter fs)
            (reader-file! a pool agg rb dfd dir name))
          (os/close dfd)
          0))))

(defn reader-worker [(p (ptr i8))] (-> (ptr i8))
  ;; Workers exchange paths and memory, never file descriptors. A private Linux
  ;; fd table removes contention on the shared table's open/close lock. Failure
  ;; (e.g. a restricted container) simply retains the normal shared table.
  (fs/os-pick (do (unshare (cast i32 CLONE-FILES)) 0) 0)  ; CLONE_FILES
  (let [wa (cast (ptr WorkerArg) p)
        pool (load (field wa pool))
        agg (load (field wa agg))
        a (alloc/overflow-arena-allocator (* 32 1048576))
        rb (rb-new a)
        m (cast (ptr i8) (field pool mutex))
        qc (cast (ptr i8) (field pool qcond))
        inflight (load (field pool in-flight))
        q (load (field pool queue))
        t0 (if (.timing pool) (now-ns) 0)
        (mut active) 0
        (mut items) 0
        (mut going) true]
    (while (= going true)
      (let [(mut have) false
            (mut item) (zeroed DirItem)]
        (pthread_mutex_lock m)
        (while (and (= (len (load q)) 0) (> (load inflight) 0))
          (pthread_cond_wait qc m))
        (match (pop! q)
          (Some [it] (do (set! (mut item) it) (set! (mut have) true) 0))
          (None [] 0))
        (pthread_mutex_unlock m)
        (if (= have true)
            (do
              (let [work-start (if (.timing pool) (now-ns) 0)]
                (if (> (len (.files (mut item))) 0)
                    (process-batch! a pool agg rb item)
                    (process-dir! a pool agg rb item))
                (when (.timing pool)
                  (set! (mut active) (+ active (- (now-ns) work-start)))
                  (set! (mut items) (+ items 1))
                  0))
              (pthread_mutex_lock m)
              (set! inflight (- (load inflight) 1))
              (when (> (len (.files item)) 0)
                (set! (.file-tasks pool) (- (.file-tasks pool) 1)))
              (when (= (load inflight) 0)
                (pthread_cond_broadcast qc)
                (pthread_cond_signal (cast (ptr i8) (field pool scond)))
                0)
              (pthread_mutex_unlock m)
              0)
            (do (set! (mut going) false) 0))))
    (when (.timing pool)
      (atomic/atomic-add (load (field pool worker-ns)) (- (now-ns) t0))
      (set! (.active-ns wa) active)
      (set! (.items wa) items)
      0)
    (cast (ptr i8) 0)))

;; --- counter side ----------------------------------------------------------
;;; Give every --dirs row its directory's total code, which dir-row-cmp uses to
;;; order directories by size while keeping each directory's languages together.
;;; Run once, after all counter aggregates have been merged.
(defn agg-dir-groups! [(a (dyn alloc/Allocator)) (agg (ptr Agg))] (-> i64)
  (when (= (.want-dirs agg) true)
    (let [drows (load (field agg dir-rows))
          n (len (load drows))
          tot (util/new-map a (slice u8) i64 (str/str-keyops))]
      (for [i 0 n]
        (let [rp (index (slice/slice-data (arraylist/al-slice (load drows))) i)
              d (.label rp)
              code (.code (.c rp))]
          (util/hm-add! tot d code)))
      (for [i 0 n]
        (let [rp (index (slice/slice-data (arraylist/al-slice (load drows))) i)
              d (.label rp)]
          (set! (.group rp) (util/option-or (get (load tot) d) 0))))
      0))
  0)

;;; Merge counter aggregate src into dst.
(defn agg-merge! [(a (dyn alloc/Allocator)) (dst (ptr Agg)) (src (ptr Agg))] (-> i64)
  (let [nf (len (.files-per dst))]
    (for [k 0 nf]
      (set! (index (slice/slice-data (load (field dst files-per))) k)
            (+ (load (index (slice/slice-data (load (field dst files-per))) k))
               (load (index (slice/slice-data (load (field src files-per))) k))))
      (counter/counts-add! (index (slice/slice-data (.counts-per dst)) k)
                           (load (index (slice/slice-data (load (field src
                                                                       counts-per)))
                                        k)))))
  (let [srows (load (field src file-rows))]
    (arraylist/al-extend! (load (field dst file-rows))
                          (slice/slice-data (arraylist/al-slice (load srows)))
                          (len (load srows))))
  (let [sdirs (load (field src dir-rows))
        nd (len (load sdirs))
        dmap (load (field dst dir-idx))
        drows (load (field dst dir-rows))]
    (for [i 0 nd]
      (let [srow (index (slice/slice-data (arraylist/al-slice (load sdirs))) i)
            key (dir-lang-key a (.label srow) (.sub srow))]
        (match (get (load dmap) key)
          (Some [di]
                (let [rowp
                        (index (slice/slice-data (arraylist/al-slice (load drows)))
                               di)]
                  (set! (.files rowp)
                        (+ (.files rowp)
                           (.files srow)))
                  (counter/counts-add! (field rowp c) (.c srow))
                  0))
          (None []
                (do
                  (set! dmap key (len (load drows)))
                  (push! drows (load srow))
                  0)))))
    0))

;;; The roots as the walk sees them: "." becomes "" so its paths stay bare
;;; ("src/x", not "./src/x"). Read-only once counting starts, so every worker
;;; aggregate can share the list.
(defn walk-roots-of [(a (dyn alloc/Allocator))
                     (roots (ptr (arraylist/ArrayList (slice u8))))] (-> (ptr (arraylist/ArrayList (slice u8))))
  (let [out (util/new-list a (slice u8))]
    (for rt
      (iter (load roots))
      (push! out (if (= rt ".") "" rt)))
    out))

(defn env-int [(a (dyn alloc/Allocator)) (name (slice u8)) (dflt i64)] (-> i64)
  (try (let [opt (try-or! (os/env-get a name) dflt)]
         (match opt
           (Some [ts]
                 (match (str/str-parse-int (os/owned-string-slice ts))
                   (Some [tv] tv)
                   (None [] dflt)))
           (None [] dflt)))))

;;; Linux spreads this I/O-heavy workload well across its online CPUs, up to
;;; 32 on the tested x86 host. macOS APFS instead favored four workers.
(defn default-readers [] (-> i64)
  (fs/os-pick (let [online (sysconf 84)]  ; _SC_NPROCESSORS_ONLN on Linux/glibc
                (if (> online 0) (if (< online 32) online 32) 8))
              4))

;;; Whether the user explicitly configured the worker count.
(defn env-present? [(a (dyn alloc/Allocator)) (name (slice u8))] (-> bool)
  (try (let [opt (try-or! (os/env-get a name) false)]
         (match opt (Some [_] true) (None [] false)))))

;;; Count everything under roots. Returns the merged aggregate.
;;; An explicit worker setting keeps its fixed-size semantics. Otherwise Linux
;;; begins with a modest traversal pool and grows when selected file batches
;;; build up, rather than paying for 32 readers in a sparse directory walk.
(defn count-all [(a (dyn alloc/Allocator))
                 (r (ptr registry/Registry))
                 (roots (ptr (arraylist/ArrayList (slice u8))))
                 (want-files bool)
                 (want-dirs bool)
                 (depth i64)
                 (hidden bool)
                 (use-ignore bool)
                 (ignore-file (slice u8))
                 (excludes (ptr (arraylist/ArrayList (slice u8))))] (-> (ptr Agg))
  (let [n-specs (registry/reg-count r)
        wroots (walk-roots-of a roots)
        ;; str-keyops initializes shared static storage on every call. Snapshot
        ;; its capability table before starting workers; creating later worker
        ;; maps must not rewrite the table used by the registry's readers.
        keyops (alloc/box! a hashmap/KeyOps (load (str/str-keyops)))
        agg (new-agg a keyops n-specs want-files want-dirs depth wroots)
        pool (alloc/box! a Pool (zeroed Pool))
        queue (util/new-list a DirItem)
        inflight (alloc/box! a i64 0)
        timing (= (env-int a "THECOUNT_PHASE_TIMING" 0) 1)
        io-ns (alloc/box! a i64 0)
        scan-ns (alloc/box! a i64 0)
        walk-ns (alloc/box! a i64 0)
        worker-ns (alloc/box! a i64 0)]
    (pthread_mutex_init (cast (ptr i8) (field pool mutex)) (cast (ptr i8) 0))
    (pthread_cond_init (cast (ptr i8) (field pool qcond)) (cast (ptr i8) 0))
    (pthread_cond_init (cast (ptr i8) (field pool scond)) (cast (ptr i8) 0))
    (util/set-fields! pool
                      (queue queue)
                      (in-flight inflight)
                      (r r)
                      (hidden hidden)
                      (use-ignore (or use-ignore (> (len ignore-file) 0)))
                      (gitignore use-ignore)
                      (ignore-file ignore-file)
                      (excludes excludes)
                      (timing timing)
                      (io-ns io-ns)
                      (scan-ns scan-ns)
                      (walk-ns walk-ns)
                      (worker-ns worker-ns))
    ;; Resolve the stdlib's lazy libc errno accessor before concurrent I/O.
    ;; Its published function pointer is immutable after this first call.
    (os/os-errno)
    ;; seed: directories enter the queue, plain-file roots count directly
    (let [nr (len (load roots))]
      (for [i 0 nr]
        (let [root (get (load wroots) i)]
          (let [dp (fs/opendir (str/str->cstr a (if (= (len root) 0) "." root)))]
            (if (!= (cast i64 dp) 0)
                (do
                  (fs/closedir dp)
                  (pool-push! pool
                              (util/zeroed-with DirItem
                                                (path root)
                                                (chain (cast (ptr CtxNode) 0)))))
                (if (= (cast i64 (access (str/str->cstr a root) 0)) 0)
                    (process-file! a r agg (rb-new a) root)
                    (do (println "thecount: no such path: {s}" root) 0))))))
      ;; Each worker walks, reads, and counts into its own aggregate.
      (let [(mut nreaders) (env-int a "THECOUNT_READERS" (default-readers))]
        (when (< nreaders 1) (set! (mut nreaders) 1))
        (when (> nreaders 32) (set! (mut nreaders) 32))
        (let [rthreads (util/must-alloc [thread/Thread] a nreaders)
              rargs (util/must-alloc [WorkerArg] a nreaders)
              adaptive
                (fs/os-pick (= (env-present? a "THECOUNT_READERS") false) false)
              initial (if (and adaptive (> nreaders 8)) 8 (load nreaders))
              (mut started) 0
              m (cast (ptr i8) (field pool mutex))
              sc (cast (ptr i8) (field pool scond))]
          (set! (.max-workers pool) nreaders)
          (set! (.wanted-workers pool) initial)
          ;; Plain-file roots have already been counted, so an empty directory
          ;; queue needs no threads. For directories, wait only for completion
          ;; or an increase in measured ready-file demand.
          (let [(mut scheduling) (> (load inflight) 0)]
            (while scheduling
              (pthread_mutex_lock m)
              (while (and (> (load inflight) 0)
                          (>= started (.wanted-workers pool)))
                (pthread_cond_wait sc m))
              (let [target
                      (if (> (load inflight) 0)
                          (.wanted-workers pool)
                          (load started))]
                (when (= (load inflight) 0) (set! scheduling false))
                (pthread_mutex_unlock m)
                (while (< started target)
                  (let [wagg
                          (new-agg a
                                   keyops
                                   n-specs
                                   want-files
                                   want-dirs
                                   depth
                                   wroots)
                        wa (index rargs started)]
                    (util/set-fields! wa (pool pool) (agg wagg))
                    (thread/thread-spawn (index rthreads started)
                                         (fnptr-of reader-worker)
                                         (cast (ptr i8) wa)))
                  (set! started (+ started 1))))))
          (set! nreaders started)
          (for [t 0 (load nreaders)]
            (thread/thread-join (index rthreads t))
            (agg-merge! a agg (load (field (index rargs t) agg))))
          (when (= timing true)
            (let [(mut b) (str/sb-new a)]
              (str/sb-push-str! (mut b) "[phase] worker ns=")
              (str/sb-push-str! (mut b)
                                (i64->str a (atomic/atomic-load worker-ns)))
              (str/sb-push-str! (mut b) " walk ns=")
              (str/sb-push-str! (mut b)
                                (i64->str a (atomic/atomic-load walk-ns)))
              (str/sb-push-str! (mut b) " io ns=")
              (str/sb-push-str! (mut b) (i64->str a (atomic/atomic-load io-ns)))
              (str/sb-push-str! (mut b) " scan ns=")
              (str/sb-push-str! (mut b)
                                (i64->str a (atomic/atomic-load scan-ns)))
              (str/sb-push-str! (mut b) " workers=[")
              (for [t 0 (load nreaders)]
                (let [wa (index rargs t)
                      wagg (load (field wa agg))
                      (mut files) 0]
                  (for [s 0 n-specs]
                    (set! (mut files)
                          (+ files
                             (load (index (slice/slice-data (.files-per wagg))
                                          s)))))
                  (when (> t 0) (str/sb-push-str! (mut b) ",") 0)
                  (str/sb-push-str! (mut b) (i64->str a t))
                  (str/sb-push-str! (mut b) ":")
                  (str/sb-push-str! (mut b) (i64->str a files))
                  (str/sb-push-str! (mut b) "/")
                  (str/sb-push-str! (mut b)
                                    (i64->str a (.active-ns wa)))))
              (str/sb-push-str! (mut b) "]")
              (try (let [_ (try-or! (write-line (stderr) (str/sb-str b)) 0)] 0)))
            0)
          (pthread_cond_destroy (cast (ptr i8) (field pool qcond)))
          (pthread_cond_destroy (cast (ptr i8) (field pool scond)))
          (pthread_mutex_destroy (cast (ptr i8) (field pool mutex)))
          agg)))))
