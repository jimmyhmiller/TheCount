(module thecount.output)

(import "coil.slice" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "coil.primitive" :as primitive)
(import "thecount.counter" :use [Counts])
(import "thecount.util" :use [must-alloc])

(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))
(extern qsort :cc c [(ptr Row) i64 i64 (fnptr c [(ptr Row) (ptr Row)] i32)] (-> void))

;;; One output row for any of the three tables.
(defstruct Row
  [(label (slice u8))  ; language name, file path, or directory
   (sub (slice u8))  ; language name on --files and --dirs rows, else ""
   (files i64)
   (c Counts)
   (group i64)])  ; --dirs: the directory's total code, see dir-row-cmp

(defn mk-row [(label (slice u8)) (sub (slice u8)) (files i64) (c Counts)] (-> Row)
  (Row
    :label label
    :sub sub
    :files files
    :c c
    :group 0))

(defn i64->str [(a (dyn Allocator)) (v i64)] (-> (slice u8))
  (let [buf (must-alloc [u8] a 32)
        n (snprintf (cast (ptr i8) buf) 32 c"%lld" v)]
    (slice-new buf (cast i64 n))))

(defn i64->pretty [(a (dyn Allocator)) (v i64)] (-> (slice u8))
  (let [raw (i64->str a v)
        n (slice-len raw)
        (mut b) (sb-new a)]
    (for [i 0 n]
      (when (and (> i 0)
                 (= (* (/ (- n i) 3) 3) (- n i)))
        (sb-push-byte! (mut b) (cast u8 #\,)))
      (sb-push-byte! (mut b) (slice-get raw i)))
    (sb-str (mut b))))

;;; Append s right-aligned in a field of width w (always at least one leading space).
(defn push-right! [(b (mut StrBuf)) (s (slice u8)) (w i64)] (-> i64)
  (let [n (slice-len s)
        (mut pad) (- w n)]
    (when (< pad 1) (store! (mut pad) 1))
    (for [_ 0 (load pad)]
      (sb-push-byte! (mut b) (cast u8 #\space)))
    (sb-push-str! (mut b) s)
    0))

;;; Append s left-aligned, padded to width w.
(defn push-left! [(b (mut StrBuf)) (s (slice u8)) (w i64)] (-> i64)
  (sb-push-str! (mut b) s)
  (let [(mut pad) (- w (slice-len s))]
    (for [_ 0 (load pad)]
      (sb-push-byte! (mut b) (cast u8 #\space)))
    0))

(defn push-repeat! [(b (mut StrBuf)) (ch i64) (n i64)] (-> i64)
  (for [_ 0 n]
    (sb-push-byte! (mut b) (cast u8 ch)))
  0)

;;; code desc, then label asc
(defn row-cmp [(x (ptr Row)) (y (ptr Row))] (-> i32)
  (let [a (.code (.c x))
        b (.code (.c y))]
    (cond (> a b) (cast i32 -1)
          (< a b) (cast i32 1)
          :else (cast i32 (str-cmp (load (field x label)) (load (field y label)))))))

;;; --dirs ordering: biggest directory first (by its total code), every row of a
;;; directory kept together, and within a directory the biggest language first.
;;; `group` carries the directory total so the comparison stays local to a row.
(defn dir-row-cmp [(x (ptr Row)) (y (ptr Row))] (-> i32)
  (let [gx (.group x)
        gy (.group y)]
    (cond (> gx gy) (cast i32 -1)
          (< gx gy) (cast i32 1)
          :else
            (let [d (str-cmp (load (field x label)) (load (field y label)))]
              (if (!= d 0)
                  (cast i32 d)
                  (let [a (load (field (field x c) code))
                        b (load (field (field y c) code))]
                    (cond (> a b) (cast i32 -1)
                          (< a b) (cast i32 1)
                          :else
                            (cast i32
                                  (str-cmp (load (field x sub))
                                           (load (field y sub)))))))))))

(const NUM-W 10)

;;; Print a full table. with-files / with-sub choose the optional columns, and
;;; `cmp` the row order (row-cmp for the flat tables, dir-row-cmp for --dirs).
(defn print-table [(a (dyn Allocator))
                   (title (slice u8))
                   (rows (slice Row))
                   (with-files bool)
                   (with-sub bool)
                   (cmp (fnptr c [(ptr Row) (ptr Row)] i32))] (-> i64)
  (qsort (slice-data rows) (slice-len rows) (sizeof Row) cmp)
  (let [n (slice-len rows)
        (mut label-w) (slice-len title)
        (mut sub-w) 9]
    (for [k 0 n]
      (let [r (index (slice-data rows) k)]
        (when (> (slice-len (load (field r label))) label-w)
          (store! (mut label-w) (slice-len (load (field r label)))))
        (when (> (slice-len (load (field r sub))) sub-w)
          (store! (mut sub-w) (slice-len (load (field r sub)))))))
    (let [lw (+ label-w 1)
          total-w
            (+ (+ lw (* NUM-W 4))
               (+ (if (= with-sub true) (+ sub-w 1) 0)
                  (if (= with-files true) NUM-W 0)))]
      (let [(mut b) (sb-new a)]
        ;; header
        (push-left! (mut b) title lw)
        (when (= with-sub true) (push-left! (mut b) "Language" (+ sub-w 1)))
        (when (= with-files true) (push-right! (mut b) "Files" NUM-W))
        (push-right! (mut b) "Lines" NUM-W)
        (push-right! (mut b) "Blanks" NUM-W)
        (push-right! (mut b) "Comments" NUM-W)
        (push-right! (mut b) "Code" NUM-W)
        (sb-push-byte! (mut b) (cast u8 #\newline))
        (push-repeat! (mut b) #\- total-w)
        (sb-push-byte! (mut b) (cast u8 #\newline))
        ;; rows + running totals
        (let [(mut t-files) 0
              (mut t-lines) 0
              (mut t-blank) 0
              (mut t-comments) 0
              (mut t-code) 0]
          (for [j 0 n]
            (let [r (index (slice-data rows) j)
                  c (field r c)]
              (push-left! (mut b) (load (field r label)) lw)
              (when (= with-sub true) (push-left! (mut b) (load (field r sub)) (+ sub-w 1)))
              (when (= with-files true)
                (push-right! (mut b) (i64->str a (load (field r files))) NUM-W))
              (push-right! (mut b) (i64->str a (load (field c lines))) NUM-W)
              (push-right! (mut b) (i64->str a (load (field c blank))) NUM-W)
              (push-right! (mut b) (i64->str a (load (field c comments))) NUM-W)
              (push-right! (mut b) (i64->str a (load (field c code))) NUM-W)
              (sb-push-byte! (mut b) (cast u8 #\newline))
              (store! (mut t-files) (+ t-files (load (field r files))))
              (store! (mut t-lines) (+ t-lines (load (field c lines))))
              (store! (mut t-blank) (+ t-blank (load (field c blank))))
              (store! (mut t-comments) (+ t-comments (load (field c comments))))
              (store! (mut t-code) (+ t-code (load (field c code))))))
          ;; total line
          (push-repeat! (mut b) #\- total-w)
          (sb-push-byte! (mut b) (cast u8 #\newline))
          (push-left! (mut b) "Total" lw)
          (when (= with-sub true) (push-left! (mut b) "" (+ sub-w 1)))
          (when (= with-files true) (push-right! (mut b) (i64->str a t-files) NUM-W))
          (push-right! (mut b) (i64->str a t-lines) NUM-W)
          (push-right! (mut b) (i64->str a t-blank) NUM-W)
          (push-right! (mut b) (i64->str a t-comments) NUM-W)
          (push-right! (mut b) (i64->str a t-code) NUM-W)
          (sb-push-byte! (mut b) (cast u8 #\newline))
          (print "{s}" (sb-str (mut b)))
          0)))))

;;; Print --dirs as a hierarchy instead of repeating the directory on every
;;; language row. Rows arrive as one (directory, language) pair and are sorted
;;; so each directory is contiguous, largest directory first.
(defn print-dir-tree [(a (dyn Allocator)) (rows (slice Row))] (-> i64)
  (qsort (slice-data rows) (slice-len rows) (sizeof Row) (fnptr-of dir-row-cmp))
  (let [n (slice-len rows)
        (mut lang-w) 8
        (mut total-files) 0
        (mut total-lines) 0
        (mut total-code) 0]
    (for [k 0 n]
      (let [r (index (slice-data rows) k)
            c (field r c)]
        (when (> (slice-len (load (field r sub))) lang-w)
          (store! (mut lang-w) (slice-len (load (field r sub)))))
        (store! (mut total-files) (+ total-files (load (field r files))))
        (store! (mut total-lines) (+ total-lines (load (field c lines))))
        (store! (mut total-code) (+ total-code (load (field c code)))))
      (let [(mut b) (sb-new a)]
        (sb-push-str! (mut b) "TheCount · ")
        (sb-push-str! (mut b) (i64->pretty a total-files))
        (sb-push-str! (mut b) " files · ")
        (sb-push-str! (mut b) (i64->pretty a total-lines))
        (sb-push-str! (mut b) " lines · ")
        (sb-push-str! (mut b) (i64->pretty a total-code))
        (sb-push-str! (mut b) " code\n\n")
        (let [(mut i) 0]
          (while (< i n)
            (let [first (index (slice-data rows) i)
                  dir (load (field first label))
                  (mut end) (+ i 1)]
              (while (and (< end n)
                          (= (str-cmp dir (load (field (index (slice-data rows) end) label))) 0))
                (store! (mut end) (+ end 1)))
              (let [last-dir (= end n)
                    branch (if (= last-dir true) "└─ " "├─ ")
                    stem (if (= last-dir true) "   " "│  ")
                    (mut dir-files) 0
                    (mut dir-code) 0]
                (sb-push-str! (mut b) branch)
                (sb-push-str! (mut b) dir)
                (sb-push-str! (mut b) "/\n")
                (for [j (load i) (load end)]
                  (let [r (index (slice-data rows) j)
                        c (field r c)
                        last-lang (= (+ j 1) end)]
                    (sb-push-str! (mut b) stem)
                    (sb-push-str! (mut b) (if (= last-lang true) "└─ " "├─ "))
                    (push-left! (mut b) (load (field r sub)) (+ lang-w 1))
                    (push-right! (mut b) (i64->pretty a (load (field r files))) NUM-W)
                    (sb-push-str! (mut b) (if (= (load (field r files)) 1) " file" " files"))
                    (push-right! (mut b) (i64->pretty a (load (field c code))) NUM-W)
                    (sb-push-str! (mut b) " code\n")
                    (store! (mut dir-files) (+ dir-files (load (field r files))))
                    (store! (mut dir-code) (+ dir-code (load (field c code))))))
                (sb-push-str! (mut b) (if (= last-dir true) "\n" "│\n"))
                (sb-push-str! (mut b) stem)
                (push-left! (mut b) "subtotal" (+ lang-w 4))
                (push-right! (mut b) (i64->pretty a dir-files) NUM-W)
                (sb-push-str! (mut b) (if (= dir-files 1) " file" " files"))
                (push-right! (mut b) (i64->pretty a dir-code) NUM-W)
                (sb-push-str! (mut b) " code\n")
                (when (= last-dir false) (sb-push-byte! (mut b) (cast u8 #\newline))))
              (store! (mut i) (load end))))
          (print "{s}" (sb-str (mut b)))
          0)))))
