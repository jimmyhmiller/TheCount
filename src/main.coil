(module thecount.main)
(import "coil.slice" :as slice)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :as arraylist)
(import "coil.hashmap" :as hashmap)
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.os" :as os)
(import "thecount.lang" :as lang)
(import "thecount.registry" :as registry)
(import "thecount.config" :as config)
(import "thecount.counter" :as counter)
(import "thecount.output" :as output)
(import "thecount.engine" :as engine)
(import "thecount.util" :as util)

(defn strip-trailing-slashes [(s (slice u8))] (-> (slice u8))
  (let [(mut n) (len s)]
    (while (and (> n 1) (= (cast i64 (get s (- n 1))) #\/))
      (set! (mut n) (- n 1)))
    (slice/subslice s 0 n)))

(defn usage [] (-> i64)
  (println "thecount — count lines of code")
  (println "")
  (println "usage: thecount [paths...] [flags]")
  (println "       thecount add-lang NAME [options]")
  (println "       thecount remove-lang NAME")
  (println "       thecount langs")
  (println "")
  (println "count flags:")
  (println "  --files        break results up by file")
  (println "  --dirs         break results up by folder")
  (println "  --depth N      folder rollup depth (default 1, implies --dirs)")
  (println "  --hidden       include hidden files and directories")
  (println "  --no-ignore    do not honor .gitignore files")
  (println "  --ignore-file F also honor ignore file F (gitignore syntax) in every directory")
  (println "  --no-config    use built-in language definitions only")
  (println "  --extensions E count only comma-separated extensions")
  (println "  --output json  print machine-readable totals (with --files: per-file rows)")
  (println "  --exclude S    skip paths containing S (repeatable)")
  (println "")
  (println "add-lang options (all tokens space-separated inside one quoted arg):")
  (println "  --like BASE    inherit everything from an existing language")
  (println "  --ext \"a b\"    file extensions, without dots")
  (println "  --file \"F G\"   exact filenames for this language")
  (println "  --line \"// #\"  line comment starters")
  (println "  --block \"/* */\"  block comment start/end pairs")
  (println "  --nested       block comments nest")
  (println "  --quotes \"str\" string delimiter characters")
  (println "  --multi \"tok\"  multiline string delimiters")
  (println "  --multiline-quotes \"str\"  quote characters allowed across lines")
  (println "")
  (println "example: thecount add-lang Jai --like c --ext jai")
  (println "languages live in ~/.config/thecount/languages — plain text, edit freely")
  0)

(defn run-count [(a (dyn alloc/Allocator))
                 (r (ptr registry/Registry))
                 (roots (ptr (arraylist/ArrayList (slice u8))))
                 (want-files bool)
                 (want-dirs bool)
                 (depth i64)
                 (hidden bool)
                 (use-ignore bool)
                 (ignore-file (slice u8))
                 (json-output bool)
                 (excludes (ptr (arraylist/ArrayList (slice u8))))] (-> i64)
  (let [n-specs (registry/reg-count r)
        clean-roots (util/new-list a (slice u8))]
    (for root
      (iter (load roots))
      (push! clean-roots (strip-trailing-slashes root)))
    (let [agg
            (engine/count-all a
                              r
                              clean-roots
                              want-files
                              want-dirs
                              depth
                              hidden
                              use-ignore
                              ignore-file
                              excludes)]
      ;; emit
      (cond (= json-output true)
              (let [files-per (slice/slice-data (.files-per agg))
                    counts-per (slice/slice-data (.counts-per agg))
                    (mut files) 0
                    (mut c) (counter/counts-zero)]
                (for [s 0 n-specs]
                  (set! (mut files) (+ files (load (index files-per s))))
                  (counter/counts-add! (mut c) (load (index counts-per s))))
                (output/print-json a
                                   files
                                   c
                                   (arraylist/al-slice (load (load (field agg
                                                                          file-rows))))
                                   want-files))
            (= want-files true)
              (output/print-table a
                                  "File"
                                  (arraylist/al-slice (load (load (field agg
                                                                         file-rows))))
                                  false
                                  true
                                  (fnptr-of output/row-cmp))
            (= want-dirs true)
              (do
                (engine/agg-dir-groups! a agg)
                (output/print-dir-tree a
                                       (arraylist/al-slice (load (load (field agg
                                                                              dir-rows))))))
            :else
              (let [rows (util/new-list a output/Row)
                    files-per (slice/slice-data (.files-per agg))
                    counts-per (slice/slice-data (.counts-per agg))]
                (for [s 0 n-specs]
                  (when (> (load (index files-per s)) 0)
                    (push! rows
                           (output/mk-row (.name (registry/reg-spec r s))
                                          ""
                                          (load (index files-per s))
                                          (load (index counts-per s))))
                    0))
                (output/print-table a
                                    "Language"
                                    (arraylist/al-slice (load rows))
                                    true
                                    false
                                    (fnptr-of output/row-cmp)))))))

(defn run-langs [(a (dyn alloc/Allocator)) (r (ptr registry/Registry))] (-> i64)
  (let [n (registry/reg-count r)
        exts (util/must-alloc [str/StrBuf] a n)]
    (for [k 0 n]
      (set! (index exts k) (str/sb-new a)))
    (hashmap/hm-for [ext idx (load (field r by-ext))]
                    (let [bp (index exts idx)]
                      (when (> (len (str/sb-str (load bp))) 0)
                        (str/sb-push-str! bp " "))
                      (str/sb-push-str! bp ext)))
    (for [j 0 n]
      (let [nm (.name (registry/reg-spec r j))
            es (str/sb-str (load (index exts j)))]
        (println "{s}: {s}" nm es)))
    0))

(defn push-directive! [(b (mut str/StrBuf)) (d (slice u8)) (val (slice u8))] (-> i64)
  (str/sb-push-str! (mut b) d)
  (str/sb-push-str! (mut b) " ")
  (str/sb-push-str! (mut b) val)
  (str/sb-push-str! (mut b) "\n")
  0)

(defn run-add-lang [(a (dyn alloc/Allocator))
                    (r (ptr registry/Registry))
                    (args (ptr (arraylist/ArrayList (slice u8))))] (-> i64)
  (let [n (len (load args))]
    (when (= n 0)
      (println "thecount add-lang: missing language name")
      (os/_exit 2)
      0)
    (let [name (get (load args) 0)
          (mut b) (str/sb-new a)
          (mut k) 1]
      (str/sb-push-str! (mut b) "\nlang ")
      (str/sb-push-str! (mut b) name)
      (str/sb-push-str! (mut b) "\n")
      (while (< k n)
        (let [arg (get (load args) k)
              val (if (< (+ k 1) n) (get (load args) (+ k 1)) "")]
          (cond (= arg "--like")
                  (do
                    (when (= (registry/reg-lookup-name r val) -1)
                      (println "thecount add-lang: unknown base language: {s}"
                               val)
                      (os/_exit 2)
                      0)
                    (push-directive! (mut b) "like" val)
                    (set! (mut k) (+ k 2)))
                (= arg "--ext")
                  (do
                    (push-directive! (mut b) "ext" val)
                    (set! (mut k) (+ k 2)))
                (= arg "--file")
                  (do
                    (push-directive! (mut b) "file" val)
                    (set! (mut k) (+ k 2)))
                (= arg "--line")
                  (do
                    (push-directive! (mut b) "line" val)
                    (set! (mut k) (+ k 2)))
                (= arg "--block")
                  (do
                    (push-directive! (mut b) "block" val)
                    (set! (mut k) (+ k 2)))
                (= arg "--quotes")
                  (do
                    (push-directive! (mut b) "quotes" val)
                    (set! (mut k) (+ k 2)))
                (= arg "--multi")
                  (do
                    (push-directive! (mut b) "multi" val)
                    (set! (mut k) (+ k 2)))
                (= arg "--multiline-quotes")
                  (do
                    (push-directive! (mut b) "multiline-quotes" val)
                    (set! (mut k) (+ k 2)))
                (= arg "--nested")
                  (do
                    (str/sb-push-str! (mut b) "nested\n")
                    (set! (mut k) (+ k 1)))
                :else
                  (do
                    (println "thecount add-lang: unknown option: {s}" arg)
                    (os/_exit 2)
                    0))))
      ;; validate the combined config before writing it
      (let [old (config/config-read a)
            (mut all) (str/sb-new a)]
        (str/sb-push-str! (mut all) old)
        (str/sb-push-str! (mut all) (str/sb-str b))
        (let [check-reg (registry/reg-new a)]
          (registry/add-builtins! check-reg)
          (config/load-config! check-reg (str/sb-str all))
          (when (= (registry/reg-lookup-name check-reg name) -1)
            (println "thecount add-lang: stanza did not register; not writing")
            (os/_exit 2)
            0)
          0)
        (config/config-write a (str/sb-str all))
        (println "registered language: {s}" name)
        (println "config: ~/.config/thecount/languages")
        0))))

(defn run-remove-lang [(a (dyn alloc/Allocator))
                       (r (ptr registry/Registry))
                       (args (ptr (arraylist/ArrayList (slice u8))))] (-> i64)
  (let [n (len (load args))]
    (when (= n 0)
      (println "thecount remove-lang: missing language name")
      (os/_exit 2)
      0)
    ;; join the args so multi-word names work unquoted
    (let [(mut b) (str/sb-new a)]
      (for [k 0 n]
        (when (> k 0) (str/sb-push-str! (mut b) " ") 0)
        (str/sb-push-str! (mut b) (get (load args) k)))
      (let [name (str/sb-str b)
            src (config/config-read a)]
        (match (config/remove-stanza a src name)
          (Some [out]
                (do
                  (config/config-write a out)
                  (println "removed language: {s}" name)
                  0))
          (None []
                (do
                  (if (>= (registry/reg-lookup-name r name) 0)
                      (println "thecount remove-lang: '{s}' is a builtin, not in your config; override it with add-lang instead"
                               name)
                      (println "thecount remove-lang: no user language named '{s}'"
                               name))
                  (os/_exit 2)
                  0)))))))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (alloc/malloc-allocator)
        nargs (cast i64 argc)
        roots (util/new-list a (slice u8))
        rest (util/new-list a (slice u8))
        (mut want-files) false
        (mut want-dirs) false
        (mut depth) 1
        (mut hidden) false
        (mut use-ignore) true
        (mut ignore-file) ""
        (mut use-user-config) true
        (mut json-output) false
        (mut extensions) ""
        excludes (util/new-list a (slice u8))
        (mut mode) 0  ; 0=count 1=add-lang 2=langs 3=help 4=remove-lang
        (mut k) 1]
    (while (< k nargs)
      (let [arg (str/cstr->str (load (index argv k)))]
        (cond (and (= k 1) (= arg "add-lang")) (do (set! (mut mode) 1) 0)
              (and (= k 1) (= arg "remove-lang")) (do (set! (mut mode) 4) 0)
              (and (= k 1) (= arg "langs")) (do (set! (mut mode) 2) 0)
              (or (= mode 1) (= mode 4)) (do (push! rest arg) 0)
              (= arg "--exclude")
                (do
                  (when (< (+ k 1) nargs)
                    (push! excludes (str/cstr->str (load (index argv (+ k 1)))))
                    (set! (mut k) (+ k 1))
                    0)
                  0)
              (or (= arg "--help") (= arg "-h") (= arg "help"))
                (do (set! (mut mode) 3) 0)
              (= arg "--files") (do (set! (mut want-files) true) 0)
              (= arg "--dirs") (do (set! (mut want-dirs) true) 0)
              (= arg "--hidden") (do (set! (mut hidden) true) 0)
              (= arg "--no-ignore") (do (set! (mut use-ignore) false) 0)
              (= arg "--ignore-file")
                (do
                  (when (< (+ k 1) nargs)
                    (set! (mut ignore-file)
                          (str/cstr->str (load (index argv (+ k 1)))))
                    (set! (mut k) (+ k 1))
                    0)
                  0)
              (= arg "--no-config") (do (set! (mut use-user-config) false) 0)
              (= arg "--extensions")
                (if (< (+ k 1) nargs)
                    (do
                      (set! (mut extensions)
                            (str/cstr->str (load (index argv (+ k 1)))))
                      (set! (mut k) (+ k 1))
                      0)
                    (do
                      (println "thecount: --extensions needs a value")
                      (os/_exit 2)
                      0))
              (= arg "--output")
                (if (< (+ k 1) nargs)
                    (let [value (str/cstr->str (load (index argv (+ k 1))))]
                      (if (= value "json")
                          (set! (mut json-output) true)
                          (if (= value "text")
                              (set! (mut json-output) false)
                              (do
                                (println "thecount: unknown output format: {s}"
                                         value)
                                (os/_exit 2)
                                0)))
                      (set! (mut k) (+ k 1))
                      0)
                    (do
                      (println "thecount: --output needs a value")
                      (os/_exit 2)
                      0))
              (= arg "--version") (do (set! (mut mode) 5) 0)
              (= arg "--depth")
                (do
                  (when (< (+ k 1) nargs)
                    (match (str/str-parse-int (str/cstr->str (load (index argv
                                                                          (+ k
                                                                             1)))))
                      (Some [d] (do (set! (mut depth) d) 0))
                      (None [] 0))
                    (set! (mut k) (+ k 1))
                    0)
                  (set! (mut want-dirs) true)
                  (when (< depth 1) (set! (mut depth) 1) 0)
                  0)
              :else (do (push! roots arg) 0)))
      (set! (mut k) (+ k 1)))
    (if (= mode 3)
        (usage)
        (if (= mode 5)
            (do (println "thecount 0.1.0-dev") 0)
            (let [r (registry/reg-new a)]
              (registry/add-builtins! r)
              (when (= use-user-config true)
                (config/load-user-langs! r)
                0)
              (when (> (len extensions) 0)
                (registry/reg-restrict-extensions! r extensions)
                0)
              (cond (= mode 1) (run-add-lang a r rest)
                    (= mode 4) (run-remove-lang a r rest)
                    (= mode 2) (run-langs a r)
                    :else
                      (do
                        (when (= (len (load roots)) 0)
                          (push! roots ".")
                          0)
                        (run-count a
                                   r
                                   roots
                                   want-files
                                   want-dirs
                                   depth
                                   hidden
                                   use-ignore
                                   ignore-file
                                   json-output
                                   excludes))))))))
